        </div>
        <p id="positions-caveats" class="muted transactions-stats-note" hidden></p>
        <div class="transactions-table-wrap agent-table-wrap">
          <table class="endpoint-table transactions-table agent-table" aria-label="Brownie Bot DeFi positions">
            <thead>
              <tr>
                <th>Protocol</th>
                <th>Type</th>
                <th>Asset</th>
                <th>Amount</th>
                <th>USD</th>
              </tr>
            </thead>
            <tbody id="positions-body" aria-busy="true">
              <tr class="agent-skeleton-row" aria-hidden="true">
                <td><span class="agent-skeleton-bar" style="width: 58%"></span></td>
                <td><span class="agent-skeleton-bar" style="width: 40%"></span></td>
                <td><span class="agent-skeleton-bar" style="width: 52%"></span></td>
                <td><span class="agent-skeleton-bar" style="width: 36%"></span></td>
                <td><span class="agent-skeleton-bar" style="width: 32%"></span></td>
              </tr>
              <tr class="agent-skeleton-row" aria-hidden="true">
                <td><span class="agent-skeleton-bar" style="width: 64%"></span></td>
                <td><span class="agent-skeleton-bar" style="width: 34%"></span></td>
                <td><span class="agent-skeleton-bar" style="width: 48%"></span></td>
                <td><span class="agent-skeleton-bar" style="width: 44%"></span></td>
                <td><span class="agent-skeleton-bar" style="width: 28%"></span></td>
              </tr>
              <tr class="agent-skeleton-row" aria-hidden="true">
                <td><span class="agent-skeleton-bar" style="width: 50%"></span></td>
                <td><span class="agent-skeleton-bar" style="width: 46%"></span></td>
                <td><span class="agent-skeleton-bar" style="width: 56%"></span></td>
                <td><span class="agent-skeleton-bar" style="width: 30%"></span></td>
                <td><span class="agent-skeleton-bar" style="width: 38%"></span></td>
              </tr>
              <tr class="agent-skeleton-row" aria-hidden="true">
                <td><span class="agent-skeleton-bar" style="width: 70%"></span></td>
                <td><span class="agent-skeleton-bar" style="width: 32%"></span></td>
                <td><span class="agent-skeleton-bar" style="width: 44%"></span></td>
                <td><span class="agent-skeleton-bar" style="width: 50%"></span></td>
                <td><span class="agent-skeleton-bar" style="width: 26%"></span></td>
              </tr>
              <tr class="agent-skeleton-row" aria-hidden="true">
                <td><span class="agent-skeleton-bar" style="width: 42%"></span></td>
                <td><span class="agent-skeleton-bar" style="width: 38%"></span></td>
                <td><span class="agent-skeleton-bar" style="width: 60%"></span></td>
                <td><span class="agent-skeleton-bar" style="width: 34%"></span></td>
                <td><span class="agent-skeleton-bar" style="width: 40%"></span></td>
              </tr>
            </tbody>
