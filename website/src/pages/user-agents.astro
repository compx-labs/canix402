  </div>

  <div
    class="agent-panel"
    role="tabpanel"
    id="panel-coming-soon"
    aria-labelledby="tab-coming-soon"
    data-agent-panel="coming-soon"
    hidden
  >
    <section class="panel">
      <h2>More agents coming soon</h2>
      <p class="muted">
        A second Canix402-powered user agent will land here when it is ready. Until then,
        explore Brownie Bot or build your own agent against the
        <a href="/mcp">MCP</a> and <a href="/endpoints">API</a>.
      </p>
    </section>
  </div>
</BaseLayout>

<script
  is:inline
  define:vars={{
    agentPageConfig: JSON.stringify({
      wallet: config.brownieBotWallet,
      indexerUrl: config.indexerBaseUrl,
      pricingUrl: config.pricingUrl,
      positionsUrl: config.publicBrowniePositionsUrl,
      accountingUrl: config.publicBrownieAccountingUrl,
      tinymanAnalyticsUrl: config.tinymanAnalyticsBaseUrl,
      tinymanAsaListUrl: config.tinymanAsaListUrl,
      tinymanAsaIconBaseUrl: config.tinymanAsaIconBaseUrl,
      protocolLogos,
      usdcAssetId: Number(config.usdcAssetId),
      txExplorerBase: config.alloTxBaseUrl,
      pollMs: config.transactionsRefreshMs
    })
  }}
>
  const {
    wallet,
    indexerUrl,
    pricingUrl,
    positionsUrl,
    accountingUrl,
    tinymanAnalyticsUrl,
    tinymanAsaListUrl,
    tinymanAsaIconBaseUrl,
    protocolLogos,
    usdcAssetId,
    txExplorerBase,
    pollMs
  } = JSON.parse(agentPageConfig);

  const MAX_TX_ROWS = 25;
  const MICRO = 1_000_000;

  /** @type {ReturnType<typeof setInterval> | null} */
  let refreshTimer = null;
  /** @type {Record<string, { unitName?: string; name?: string; logoPng?: string }> | null} */
  let asaListCache = null;
  /** @type {Promise<Record<string, { unitName?: string; name?: string; logoPng?: string }>> | null} */
  let asaListPromise = null;
  /** @type {number | null} */
  let liquidUsdTotal = null;
  /** @type {number | null} */
  let defiNetUsdTotal = null;
  let refreshInFlight = false;
  let refreshGeneration = 0;

  /**
   * @param {string} value
   */
  function escapeHtml(value) {
    return value
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#39;");
  }

  /**
   * @returns {Promise<Record<string, { unitName?: string; name?: string; logoPng?: string }>>}
   */
  async function loadAsaList() {
    if (asaListCache) return asaListCache;
    if (asaListPromise) return asaListPromise;

    asaListPromise = (async () => {
      /** @type {Record<string, { unitName?: string; name?: string; logoPng?: string }>} */
      const mapped = {};
      try {
        const response = await fetch(tinymanAsaListUrl);
        if (!response.ok) return mapped;
        const payload = await response.json();
        if (!payload || typeof payload !== "object") return mapped;
        for (const [id, entry] of Object.entries(payload)) {
          if (!entry || typeof entry !== "object") continue;
          const record = /** @type {Record<string, unknown>} */ (entry);
          const logo = record.logo;
          const logoPng =
            logo && typeof logo === "object" && typeof /** @type {Record<string, unknown>} */ (logo).png === "string"
              ? /** @type {string} */ (/** @type {Record<string, unknown>} */ (logo).png)
              : `${tinymanAsaIconBaseUrl.replace(/\/$/, "")}/${id}/icon.png`;
          mapped[String(id)] = {
            unitName:
              typeof record.unit_name === "string" ? record.unit_name : undefined,
            name: typeof record.name === "string" ? record.name : undefined,
            logoPng
          };
        }
      } catch {
        // Icons fall back to constructed CDN URLs below.
      }
      asaListCache = mapped;
      return mapped;
    })();

    return asaListPromise;
  }

  /**
   * @param {number | null | undefined} assetId
   * @param {string | null | undefined} symbol
   */
  function assetCell(assetId, symbol) {
    const id =
      assetId === null || assetId === undefined || !Number.isFinite(Number(assetId))
        ? null
        : Number(assetId);
    const meta = id === null ? undefined : asaListCache?.[String(id)];
    const label =
      (typeof symbol === "string" && symbol.length > 0 ? symbol : null) ||
      meta?.unitName ||
      meta?.name ||
      (id === 0 ? "ALGO" : id === null ? "—" : `ASA ${id}`);
    const iconUrl =
      id === null
        ? null
        : meta?.logoPng ||
          `${tinymanAsaIconBaseUrl.replace(/\/$/, "")}/${id}/icon.png`;
    const idLabel = id === null ? "" : id === 0 ? "ALGO · 0" : `ASA ${id}`;

    return `<span class="agent-asset-cell">
      ${
        iconUrl
          ? `<img class="agent-asset-icon" src="${escapeHtml(iconUrl)}" alt="" width="20" height="20" loading="lazy" decoding="async" onerror="this.style.visibility='hidden'" />`
          : `<span class="agent-asset-icon agent-asset-icon--empty" aria-hidden="true"></span>`
      }
      <span class="agent-asset-text">
        <strong>${escapeHtml(label)}</strong>
        ${idLabel ? `<span class="muted">${escapeHtml(idLabel)}</span>` : ""}
      </span>
    </span>`;
  }

  /**
   * @param {string | null | undefined} protocol
   */
  function protocolCell(protocol) {
    const slug = typeof protocol === "string" ? protocol : "";
    const logo = slug && protocolLogos?.[slug] ? String(protocolLogos[slug]) : "";
    const label = slug || "—";
    return `<span class="agent-protocol-cell">
      ${
        logo
          ? `<img class="agent-protocol-icon" src="${escapeHtml(logo)}" alt="" width="20" height="20" loading="lazy" decoding="async" onerror="this.style.visibility='hidden'" />`
          : `<span class="agent-protocol-icon agent-protocol-icon--empty" aria-hidden="true"></span>`
      }
      <span>${escapeHtml(label)}</span>
    </span>`;
  }

  /**
   * @param {string} address
   */
  function truncateAddress(address) {
    if (address.length <= 16) return address;
    return `${address.slice(0, 8)}…${address.slice(-8)}`;
  }

  /**
   * @param {number | null | undefined} value
   */
  function formatUsd(value) {
    if (value === null || value === undefined || !Number.isFinite(value)) {
      return "—";
    }
    return value.toLocaleString(undefined, {
      style: "currency",
      currency: "USD",
      maximumFractionDigits: 2
    });
  }

  /**
   * @param {number | null | undefined} value
   */
  function formatSignedUsd(value) {
    if (value === null || value === undefined || !Number.isFinite(value)) {
      return "—";
    }
    const absolute = formatUsd(Math.abs(value));
    if (value > 0) return `+${absolute}`;
    if (value < 0) return `-${absolute}`;
    return absolute;
  }

  function updateHeroTvl() {
    const tvlEl = document.getElementById("agent-tvl");
    if (!tvlEl) return;
    // Only show the sum of the same figures as Liquid USD + Net cards.
    // Keep the last good value while a refresh is mid-flight or incomplete —
    // do not flash back to "—" on tab focus / overlapping polls.
    if (typeof liquidUsdTotal === "number" && typeof defiNetUsdTotal === "number") {
      tvlEl.textContent = formatUsd(liquidUsdTotal + defiNetUsdTotal);
      tvlEl.classList.remove("is-skeleton");
    }
  }

  /**
   * @param {boolean} loading
   */
  function setTvlLoading(loading) {
    const card = document.getElementById("agent-tvl-card");
    const tvlEl = document.getElementById("agent-tvl");
    if (card) {
      card.classList.toggle("is-loading", loading);
      card.setAttribute("aria-busy", loading ? "true" : "false");
    }
    if (!tvlEl || !loading) return;
    const hasValue =
      typeof liquidUsdTotal === "number" && typeof defiNetUsdTotal === "number";
    if (!hasValue && !tvlEl.classList.contains("is-skeleton")) {
      tvlEl.classList.add("is-skeleton");
      tvlEl.innerHTML =
        `<span class="agent-skeleton-bar agent-skeleton-bar--value" aria-hidden="true"></span>` +
        `<span class="visually-hidden">Loading total value</span>`;
    }
  }

  /**
   * @param {string} tbodyId
   * @returns {boolean}
   */
  function tableHasDataRows(tbodyId) {
    const tbody = document.getElementById(tbodyId);
    if (!tbody) return false;
    return Boolean(
      tbody.querySelector("tr:not(.agent-skeleton-row) td:not([colspan])")
    );
  }

  /**
   * @param {string} tbodyId
   * @param {number} columnCount
   * @param {number} [rowCount]
   */
  function renderSkeleton(tbodyId, columnCount, rowCount = 4) {
    const tbody = document.getElementById(tbodyId);
    if (!tbody) return;
    const widths = [68, 42, 56, 36, 48, 54, 30, 62, 40, 44];
    const rows = Array.from({ length: rowCount }, (_, rowIndex) => {
      const cells = Array.from({ length: columnCount }, (__, colIndex) => {
        const width = widths[(rowIndex * columnCount + colIndex) % widths.length];
        return `<td><span class="agent-skeleton-bar" style="width: ${width}%"></span></td>`;
      }).join("");
      return `<tr class="agent-skeleton-row" aria-hidden="true">${cells}</tr>`;
    }).join("");
    tbody.innerHTML = rows;
    tbody.setAttribute("aria-busy", "true");
    tbody.closest(".agent-table-wrap")?.classList.remove("is-refreshing");
  }

  /**
   * @param {string} tbodyId
   * @param {number} columnCount
   * @param {number} [rowCount]
   */
  function beginTableLoading(tbodyId, columnCount, rowCount = 4) {
    const wrap = document.getElementById(tbodyId)?.closest(".agent-table-wrap");
    if (tableHasDataRows(tbodyId)) {
      wrap?.classList.add("is-refreshing");
      const tbody = document.getElementById(tbodyId);
      tbody?.setAttribute("aria-busy", "true");
      return;
    }
    renderSkeleton(tbodyId, columnCount, rowCount);
  }

  /**
   * @param {string} tbodyId
   */
  function endTableLoading(tbodyId) {
    const tbody = document.getElementById(tbodyId);
    if (!tbody) return;
    tbody.removeAttribute("aria-busy");
    tbody.closest(".agent-table-wrap")?.classList.remove("is-refreshing");
  }

  /**
   * @param {number | null} value
   * @param {string} note
   */
  function setHeroPnl(value, note) {
    const pnlEl = document.getElementById("agent-pnl");
    const noteEl = document.getElementById("agent-pnl-note");
    if (pnlEl) {
      pnlEl.textContent = formatSignedUsd(value);
      pnlEl.classList.toggle("is-positive", typeof value === "number" && value > 0);
      pnlEl.classList.toggle("is-negative", typeof value === "number" && value < 0);
    }
    if (noteEl) noteEl.textContent = note;
  }

  /**
   * Mainnet USDC is always $1 for display.
   * Prefer live /pricing (same source as wallet assets) over upstream usdValue —
   * CompX lending rows can ship oracle-inflated totals.
   * @param {number | null | undefined} assetId
   * @param {string | number | null | undefined} amount
   * @param {number | null | undefined} usdValue
   * @param {Record<string, number>} [pricesById]
   */
  function resolveUsdValue(assetId, amount, usdValue, pricesById) {
    const units = typeof amount === "number" ? amount : Number(amount);
    if (Number(assetId) === Number(usdcAssetId)) {
      return Number.isFinite(units) ? units : null;
    }
    if (pricesById && assetId !== null && assetId !== undefined) {
      const price = pricesById[String(assetId)];
      if (typeof price === "number" && Number.isFinite(price) && Number.isFinite(units)) {
        return units * price;
      }
    }
    return typeof usdValue === "number" && Number.isFinite(usdValue)
      ? usdValue
      : null;
  }

  /**
   * @param {string | number} amount
   * @param {number} decimals
   */
  function formatAmount(amount, decimals) {
    const raw = typeof amount === "string" ? amount : String(amount);
    if (!/^\d+$/.test(raw)) return raw;
    if (decimals <= 0) return Number(raw).toLocaleString();
    const padded = raw.padStart(decimals + 1, "0");
    const whole = padded.slice(0, -decimals);
    const frac = padded.slice(-decimals).replace(/0+$/, "");
    const wholeFmt = Number(whole).toLocaleString();
    return frac ? `${wholeFmt}.${frac}` : wholeFmt;
  }

  /**
   * @param {number} unixSeconds
   */
  function formatTime(unixSeconds) {
    if (!unixSeconds) return "—";
    return new Date(unixSeconds * 1000).toLocaleString(undefined, {
      dateStyle: "medium",
      timeStyle: "short"
    });
  }

  /**
   * @param {string} message
   * @param {boolean} [isError]
   */
  function setStatus(message, isError = false) {
    const statusEl = document.getElementById("agent-status");
    if (!statusEl) return;
    statusEl.textContent = message;
    statusEl.classList.toggle("transactions-status-error", isError);
  }

  /**
   * @param {string} tbodyId
   * @param {number} colspan
   * @param {string} message
   */
  function renderEmpty(tbodyId, colspan, message) {
    const tbody = document.getElementById(tbodyId);
    if (!tbody) return;
    tbody.innerHTML = `<tr><td colspan="${colspan}" class="muted">${escapeHtml(message)}</td></tr>`;
    endTableLoading(tbodyId);
  }

  function setupTabs() {
    const tabs = Array.from(
      document.querySelectorAll("[data-agent-tab]")
    );
    const panels = Array.from(
      document.querySelectorAll("[data-agent-panel]")
    );

    /**
     * @param {string} id
     */
    function activate(id) {
      for (const tab of tabs) {
        const selected = tab.getAttribute("data-agent-tab") === id;
        tab.classList.toggle("is-active", selected);
        tab.setAttribute("aria-selected", selected ? "true" : "false");
      }
      for (const panel of panels) {
        const match = panel.getAttribute("data-agent-panel") === id;
        panel.hidden = !match;
      }
      if (id === "brownie" || id === "coming-soon") {
        history.replaceState(null, "", `#${id}`);
      }
    }

    for (const tab of tabs) {
      tab.addEventListener("click", () => {
        const id = tab.getAttribute("data-agent-tab");
        if (id) activate(id);
      });
    }

    const hash = window.location.hash.replace(/^#/, "");
    if (hash === "coming-soon" || hash === "brownie") {
      activate(hash);
    }
  }

  /**
   * @returns {Promise<{ holdings: Array<{ assetId: number; symbol: string; amountRaw: string; decimals: number; amount: string; usdValue: number | null }>; priced: boolean }>}
   */
  async function fetchHoldings() {
    const response = await fetch(`${indexerUrl}/v2/accounts/${wallet}`);
    if (!response.ok) {
      throw new Error(`Indexer account request failed (${response.status})`);
    }
    const payload = await response.json();
    const account = payload.account ?? {};
    /** @type {Array<{ assetId: number; symbol: string; amountRaw: string; decimals: number; amount: string; usdValue: number | null }>} */
    const holdings = [];

    const algoRaw = String(account.amount ?? 0);
    holdings.push({
      assetId: 0,
      symbol: "ALGO",
      amountRaw: algoRaw,
      decimals: 6,
      amount: formatAmount(algoRaw, 6),
      usdValue: null
    });

    const assets = Array.isArray(account.assets) ? account.assets : [];
    for (const asset of assets) {
      const amountRaw = String(asset.amount ?? 0);
      if (amountRaw === "0") continue;
      const assetId = Number(asset["asset-id"] ?? 0);
      holdings.push({
        assetId,
        symbol: `ASA ${assetId}`,
        amountRaw,
        decimals: 0,
        amount: amountRaw,
        usdValue: null
      });
    }

    const assetIds = holdings.map((h) => h.assetId);
    /** @type {Record<string, number | null>} */
    let pricesById = {};
    let priced = false;

    pricesById = await fetchUsdPrices(assetIds);
    // Mainnet USDC is always $1.
    pricesById[String(usdcAssetId)] = 1;
    priced = Object.keys(pricesById).length > 0;

    // Enrich ASA decimals/symbols from indexer when possible (best-effort, capped).
    const asaHoldings = holdings.filter((h) => h.assetId !== 0).slice(0, 40);
    await Promise.all(
      asaHoldings.map(async (holding) => {
        try {
          const assetRes = await fetch(
            `${indexerUrl}/v2/assets/${holding.assetId}`
          );
          if (!assetRes.ok) return;
          const assetPayload = await assetRes.json();
          const params = assetPayload.asset?.params ?? {};
          const decimals = Number(params.decimals ?? 0);
          const unit = typeof params["unit-name"] === "string"
            ? params["unit-name"]
            : typeof params.name === "string"
              ? params.name
              : holding.symbol;
          holding.decimals = Number.isFinite(decimals) ? decimals : 0;
          holding.symbol = unit || holding.symbol;
          holding.amount = formatAmount(holding.amountRaw, holding.decimals);
        } catch {
          // keep defaults
        }
      })
    );

    for (const holding of holdings) {
      const price = pricesById[String(holding.assetId)];
      if (typeof price === "number" && Number.isFinite(price)) {
        const human = Number(holding.amountRaw) / 10 ** holding.decimals;
        holding.usdValue = Number.isFinite(human) ? human * price : null;
      }
    }

    const MIN_AMOUNT = 0.01;
    const visible = holdings.filter((h) => {
      const human = Number(h.amountRaw) / 10 ** h.decimals;
      return Number.isFinite(human) && human >= MIN_AMOUNT;
    });

    return { holdings: visible, priced };
  }

  /**
   * Prefer Canix POST /pricing; fall back to Tinyman Analytics (browser CORS-safe).
   * @param {number[]} assetIds
   * @returns {Promise<Record<string, number>>}
   */
  async function fetchUsdPrices(assetIds) {
    const unique = [...new Set(assetIds.filter((id) => Number.isFinite(id)))];
    if (unique.length === 0) return {};

    try {
      const priceResponse = await fetch(pricingUrl, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ assetIds: unique })
      });
      if (priceResponse.ok) {
        const pricePayload = await priceResponse.json();
        const prices = Array.isArray(pricePayload.prices)
          ? pricePayload.prices
          : Array.isArray(pricePayload.data?.prices)
            ? pricePayload.data.prices
            : [];
        /** @type {Record<string, number>} */
        const mapped = {};
        for (const entry of prices) {
          const id = String(entry.assetId ?? entry.asset_id ?? "");
          const priceUsd =
            typeof entry.priceUsd === "number"
              ? entry.priceUsd
              : typeof entry.price === "number"
                ? entry.price
                : null;
          if (id && typeof priceUsd === "number" && Number.isFinite(priceUsd)) {
            mapped[id] = priceUsd;
          }
        }
        if (Object.keys(mapped).length > 0) {
          mapped[String(usdcAssetId)] = 1;
          return mapped;
        }
      }
    } catch {
      // Gateway CORS may block until Caddy is redeployed — fall through.
    }

    const fallback = await fetchTinymanUsdPrices(unique);
    fallback[String(usdcAssetId)] = 1;
    return fallback;
  }

  /**
   * @param {number[]} assetIds
   * @returns {Promise<Record<string, number>>}
   */
  async function fetchTinymanUsdPrices(assetIds) {
    const base = tinymanAnalyticsUrl.replace(/\/$/, "");
    /** @type {Record<string, number>} */
    const mapped = {};

    await Promise.all(
      assetIds.slice(0, 40).map(async (assetId) => {
        try {
          const response = await fetch(`${base}/assets/${assetId}/`);
          if (!response.ok) return;
          const payload = await response.json();
          const price = Number(payload.price_in_usd);
          if (Number.isFinite(price) && price >= 0) {
            mapped[String(assetId)] = price;
          }
        } catch {
          // skip missing/unpriced assets
        }
      })
    );

    return mapped;
  }

  /**
   * @param {Awaited<ReturnType<typeof fetchHoldings>>} result
   */
  function renderHoldings(result) {
    const { holdings, priced } = result;
    const stats = document.getElementById("holdings-stats");
    const countEl = document.getElementById("holdings-count");
    const totalEl = document.getElementById("holdings-total");
    const tbody = document.getElementById("holdings-body");
    if (!tbody) return;

    if (holdings.length === 0) {
      if (stats) stats.hidden = true;
      liquidUsdTotal = 0;
      updateHeroTvl();
      renderEmpty(
        "holdings-body",
        3,
        "No liquid holdings of 0.01 asset units or more."
      );
      return;
    }

    const valued = holdings.map((h) => ({
      ...h,
      usdValue: resolveUsdValue(h.assetId, h.amount, h.usdValue)
    }));
    const pricedRows = valued.filter((h) => typeof h.usdValue === "number");
    const totalUsd = pricedRows.reduce((sum, h) => sum + (h.usdValue ?? 0), 0);
    liquidUsdTotal =
      (priced || pricedRows.length > 0) && pricedRows.length > 0 ? totalUsd : null;
    updateHeroTvl();

    if (stats && countEl && totalEl) {
      countEl.textContent = holdings.length.toLocaleString();
      totalEl.textContent =
        typeof liquidUsdTotal === "number" ? formatUsd(liquidUsdTotal) : "—";
      stats.hidden = false;
    }

    const sorted = [...valued].sort((a, b) => {
      const aUsd = typeof a.usdValue === "number" ? a.usdValue : -Infinity;
      const bUsd = typeof b.usdValue === "number" ? b.usdValue : -Infinity;
      return bUsd - aUsd;
    });

    tbody.innerHTML = sorted
      .map(
        (h) => `<tr>
          <td>${assetCell(h.assetId, h.symbol)}</td>
          <td>${escapeHtml(h.amount)}</td>
          <td>${formatUsd(h.usdValue)}</td>
        </tr>`
      )
      .join("");
    endTableLoading("holdings-body");
  }

  async function fetchPositions() {
    const response = await fetch(positionsUrl);
    if (!response.ok) {
      throw new Error(`Positions request failed (${response.status})`);
    }
    return response.json();
  }

  /**
   * @param {any} payload
   */
  async function renderPositions(payload) {
    const rows = Array.isArray(payload.data) ? payload.data : [];
    const protocols = Array.isArray(payload.protocols) ? payload.protocols : [];
    const stats = document.getElementById("positions-stats");
    const countEl = document.getElementById("positions-count");
    const suppliedEl = document.getElementById("positions-supplied");
    const rewardsEl = document.getElementById("positions-rewards");
    const netEl = document.getElementById("positions-net");
    const caveatsEl = document.getElementById("positions-caveats");
    const tbody = document.getElementById("positions-body");
    if (!tbody) return;

    const assetIds = rows
      .map((row) => Number(row.assetId))
      .filter((id) => Number.isFinite(id));
    /** @type {Record<string, number>} */
    let pricesById = {};
    try {
      pricesById = await fetchUsdPrices(assetIds);
    } catch {
      // Fall back to upstream usdValue when pricing is unreachable.
    }

    const valued = rows.map((row) => ({
      ...row,
      usdValue: resolveUsdValue(
        row.assetId,
        row.amount,
        row.usdValue,
        pricesById
      )
    }));

    let suppliedUsd = 0;
    let rewardsUsd = 0;
    let borrowedUsd = 0;
    let suppliedComplete = true;
    let rewardsComplete = true;
    let borrowedComplete = true;
    for (const row of valued) {
      const type = String(row.positionType ?? "");
      const usd = row.usdValue;
      if (type === "debt") {
        if (typeof usd === "number") borrowedUsd += usd;
        else borrowedComplete = false;
      } else if (type === "reward") {
        if (typeof usd === "number") rewardsUsd += usd;
        else rewardsComplete = false;
      } else if (type === "supplied" || type === "lp" || type === "staked") {
        if (typeof usd === "number") suppliedUsd += usd;
        else suppliedComplete = false;
      }
    }
    const netUsd =
      suppliedComplete && rewardsComplete && borrowedComplete
        ? suppliedUsd + rewardsUsd - borrowedUsd
        : null;
    defiNetUsdTotal = netUsd;
    updateHeroTvl();

    if (stats && countEl && suppliedEl && rewardsEl && netEl) {
      countEl.textContent = rows.length.toLocaleString();
      suppliedEl.textContent = formatUsd(suppliedComplete ? suppliedUsd : null);
      rewardsEl.textContent = formatUsd(rewardsComplete ? rewardsUsd : null);
      netEl.textContent = formatUsd(netUsd);
      stats.hidden = false;
    }

    const partial = protocols.filter(
      (p) => p.status === "partial" || p.status === "unavailable"
    );
    if (caveatsEl) {
      if (partial.length > 0) {
        caveatsEl.hidden = false;
        caveatsEl.textContent = `Incomplete protocol coverage: ${partial
          .map((p) => `${p.protocol} (${p.status})`)
          .join(", ")}.`;
      } else {
        caveatsEl.hidden = true;
        caveatsEl.textContent = "";
      }
    }

    if (rows.length === 0) {
      renderEmpty("positions-body", 5, "No DeFi positions found.");
      return;
    }

    const sorted = [...valued].sort((a, b) => {
      const aUsd = typeof a.usdValue === "number" ? a.usdValue : -Infinity;
      const bUsd = typeof b.usdValue === "number" ? b.usdValue : -Infinity;
      return bUsd - aUsd;
    });

    tbody.innerHTML = sorted
      .map((row) => {
        const symbol = row.assetSymbol ?? null;
        return `<tr>
          <td>${protocolCell(row.protocol)}</td>
          <td>${escapeHtml(String(row.positionType ?? "—"))}</td>
          <td>${assetCell(row.assetId, symbol)}</td>
          <td>${escapeHtml(String(row.amount ?? "—"))}</td>
          <td>${formatUsd(row.usdValue)}</td>
        </tr>`;
      })
      .join("");
    endTableLoading("positions-body");
  }

  /**
   * @param {Record<string, unknown>} txn
   */
  function summarizeTx(txn) {
    const type = String(txn["tx-type"] ?? "unknown");
    if (type === "pay") {
      const payment = /** @type {Record<string, unknown>} */ (
        txn["payment-transaction"] ?? {}
      );
      const amount = Number(payment.amount ?? 0);
      return `ALGO ${formatAmount(String(amount), 6)}`;
    }
    if (type === "axfer") {
      const transfer = /** @type {Record<string, unknown>} */ (
        txn["asset-transfer-transaction"] ?? {}
      );
      const assetId = transfer["asset-id"];
      const amount = Number(transfer.amount ?? 0);
      return `ASA ${assetId}: ${amount.toLocaleString()}`;
    }
    if (type === "appl") {
      const appl = /** @type {Record<string, unknown>} */ (
        txn["application-transaction"] ?? {}
      );
      const appId = appl["application-id"];
      return appId ? `App ${appId}` : "Application call";
    }
    return type;
  }

  async function fetchTransactions() {
    const params = new URLSearchParams({ limit: String(MAX_TX_ROWS) });
    const response = await fetch(
      `${indexerUrl}/v2/accounts/${wallet}/transactions?${params.toString()}`
    );
    if (!response.ok) {
      throw new Error(`Indexer transactions failed (${response.status})`);
    }
    const payload = await response.json();
    return Array.isArray(payload.transactions) ? payload.transactions : [];
  }

  /**
   * @param {Array<Record<string, unknown>>} transactions
   */
  function renderTransactions(transactions) {
    const tbody = document.getElementById("agent-tx-body");
    if (!tbody) return;

    if (transactions.length === 0) {
      renderEmpty("agent-tx-body", 5, "No recent transactions found.");
      return;
    }

    tbody.innerHTML = transactions
      .slice(0, MAX_TX_ROWS)
      .map((txn) => {
        const txid = String(txn.id ?? "");
        const round = Number(txn["confirmed-round"] ?? 0);
        const roundTime = Number(txn["round-time"] ?? 0);
        const type = String(txn["tx-type"] ?? "—");
        const url = `${txExplorerBase}/${txid}`;
        return `<tr>
          <td>${formatTime(roundTime)}</td>
          <td>${escapeHtml(type)}</td>
          <td>${escapeHtml(summarizeTx(txn))}</td>
          <td>${round ? round.toLocaleString() : "—"}</td>
          <td><a href="${escapeHtml(url)}" target="_blank" rel="noopener noreferrer">${escapeHtml(truncateAddress(txid))}</a></td>
        </tr>`;
      })
      .join("");
    endTableLoading("agent-tx-body");
  }

  async function fetchAccountingPnl() {
    if (!accountingUrl) {
      setHeroPnl(null, "Connect accounting feed");
      return;
    }
    const response = await fetch(accountingUrl);
    if (!response.ok) {
      throw new Error(`Accounting request failed (${response.status})`);
    }
    const payload = await response.json();
    const summary = payload?.summary ?? payload?.data?.summary ?? null;
    const pnlRaw = summary?.pnlUsd;
    const pnlAvailable = summary?.pnlAvailable === true;
    const pnl =
      pnlAvailable && pnlRaw !== null && pnlRaw !== undefined && pnlRaw !== ""
        ? Number(pnlRaw)
        : null;
    if (typeof pnl === "number" && Number.isFinite(pnl)) {
      setHeroPnl(pnl, "vs prior snapshot");
      return;
    }
    setHeroPnl(null, "Awaiting baseline snapshot");
  }

  async function refreshPortfolio() {
    if (refreshInFlight) return;
    refreshInFlight = true;
    const generation = ++refreshGeneration;
    const errors = [];

    setTvlLoading(true);
    beginTableLoading("holdings-body", 3, 4);
    beginTableLoading("positions-body", 5, 5);
    beginTableLoading("agent-tx-body", 5, 5);

    try {
      try {
        await loadAsaList();
      } catch {
        // Non-fatal: icons fall back to CDN URL pattern.
      }
      if (generation !== refreshGeneration) return;

      try {
        const holdings = await fetchHoldings();
        if (generation !== refreshGeneration) return;
        renderHoldings(holdings);
      } catch (error) {
        if (generation !== refreshGeneration) return;
        const message = error instanceof Error ? error.message : "Unknown error";
        errors.push(`holdings: ${message}`);
        liquidUsdTotal = null;
        renderEmpty("holdings-body", 3, "Unable to load holdings.");
        const stats = document.getElementById("holdings-stats");
        if (stats) stats.hidden = true;
      }

      try {
        const positions = await fetchPositions();
        if (generation !== refreshGeneration) return;
        await renderPositions(positions);
        if (generation !== refreshGeneration) return;
      } catch (error) {
        if (generation !== refreshGeneration) return;
        const message = error instanceof Error ? error.message : "Unknown error";
        errors.push(`positions: ${message}`);
        defiNetUsdTotal = null;
        renderEmpty("positions-body", 5, "Unable to load positions.");
        const stats = document.getElementById("positions-stats");
        if (stats) stats.hidden = true;
      }

      if (
        typeof liquidUsdTotal === "number" &&
        typeof defiNetUsdTotal === "number"
      ) {
        setTvlLoading(false);
      }

      try {
        await fetchAccountingPnl();
        if (generation !== refreshGeneration) return;
      } catch (error) {
        if (generation !== refreshGeneration) return;
        const message = error instanceof Error ? error.message : "Unknown error";
        errors.push(`accounting: ${message}`);
        setHeroPnl(null, "Accounting unavailable");
      }

      try {
        const transactions = await fetchTransactions();
        if (generation !== refreshGeneration) return;
        renderTransactions(transactions);
      } catch (error) {
        if (generation !== refreshGeneration) return;
        const message = error instanceof Error ? error.message : "Unknown error";
        errors.push(`transactions: ${message}`);
        renderEmpty("agent-tx-body", 5, "Unable to load transactions.");
      }

      const refreshedAt = new Date().toLocaleString(undefined, {
        dateStyle: "medium",
        timeStyle: "short"
      });
      if (errors.length > 0) {
        setStatus(
          `Partial refresh at ${refreshedAt}. ${errors.join("; ")}`,
          true
        );
      } else {
        setStatus(`Portfolio refreshed ${refreshedAt}. Auto-refresh every ${Math.round(pollMs / 1000)}s.`);
      }
    } finally {
      if (generation === refreshGeneration) {
        // If TVL never resolved (partial pricing), drop the loading chrome
        // without wiping a previously shown value.
        const tvlEl = document.getElementById("agent-tvl");
        const stillUnresolved =
          typeof liquidUsdTotal !== "number" ||
          typeof defiNetUsdTotal !== "number";
        if (stillUnresolved && tvlEl?.classList.contains("is-skeleton")) {
          tvlEl.classList.remove("is-skeleton");
          tvlEl.textContent = "—";
        }
        setTvlLoading(false);
        endTableLoading("holdings-body");
        endTableLoading("positions-body");
        endTableLoading("agent-tx-body");
        refreshInFlight = false;
      }
    }
  }

  function startAutoRefresh() {
    if (refreshTimer) clearInterval(refreshTimer);
    refreshTimer = setInterval(refreshPortfolio, pollMs);
  }

  setupTabs();
  refreshPortfolio();
  startAutoRefresh();

  document.addEventListener("visibilitychange", () => {
    if (document.visibilityState === "visible") {
      refreshPortfolio();
    }
  });
</script>
