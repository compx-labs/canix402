---
import BaseLayout from "../layouts/BaseLayout.astro";
import CodeBlock from "../components/CodeBlock.astro";
import { config } from "../lib/config";
import aggregateSample from "../data/opportunities.sample.json";
import searchSample from "../data/opportunities-search.sample.json";
import personalizedSample from "../data/opportunities-personalized.sample.json";
import eligibilitySample from "../data/eligibility.sample.json";
import plansSample from "../data/plans.sample.json";
import protocolSample from "../data/protocol-opportunities.sample.json";
import positionsSample from "../data/positions.sample.json";
import positionsClaimableSample from "../data/positions-claimable.sample.json";
import executionShapesSample from "../data/execution-shapes.sample.json";
import executionQuotesSample from "../data/execution-quotes.sample.json";
import swapsQuoteSample from "../data/swaps-quote.sample.json";
import swapsOptinSample from "../data/swaps-optin.sample.json";
import swapsTransactionsSample from "../data/swaps-transactions.sample.json";

const format = (value: unknown): string => JSON.stringify(value, null, 2);
const eligibilityCurl = `curl -i ${config.gatewayBaseUrl}/eligibility -H 'content-type: application/json' -d '{"address":"YOUR_ALGORAND_ADDRESS","opportunityIds":["reti-staking-12"]}'`; // pragma: allowlist secret
const plansCurl = `curl -i ${config.gatewayBaseUrl}/plans -H 'content-type: application/json' -d '{"address":"YOUR_ALGORAND_ADDRESS","budget":{"assetId":0,"amount":"1000000"},"constraints":{"noNewBorrows":true,"executionReadyOnly":true},"opportunityIds":["reti-staking-12"]}'`; // pragma: allowlist secret
---

<BaseLayout
  title="Examples | CANIX402"
  description="Copy-paste Canix402 API examples for discovery, OpenAPI, x402 signed retries, opportunities, positions, execution shapes/quotes, and Haystack swaps."
  keywords="Canix402 examples, x402 payment examples, API samples, personalized opportunities, execution quotes, positions, Haystack swaps, Algorand DeFi responses"
>
  <h1 class="page-title">Examples</h1>
  <p class="muted">All examples use the public Caddy gateway URL. Replace placeholders before running paid retries.</p>

  <section class="panel">
    <h2>MCP discovery tool</h2>
    <p>
      After connecting to <a href="/mcp">{config.mcpUrl}</a>, call <code>canix_get_discovery</code> for
      the same endpoint catalog as HTTP <code>/discovery</code> (free tool).
    </p>
    <CodeBlock
      code={`# Example: MCP client invokes canix_get_discovery (no payment required)\n# Paid tools: first call returns PAYMENT_REQUIRED; retry with paymentSignature`}
    />
  </section>

  <section class="panel">
    <h2>Discovery fetch (HTTP)</h2>
    <CodeBlock code={`curl -s ${config.discoveryUrl} | jq '.data.endpoints[] | {path, access, summary}'`} />
  </section>

  <section class="panel">
    <h2>OpenAPI fetch</h2>
    <CodeBlock code={`curl -s ${config.openApiUrl} | jq '.info, (.paths | keys)'`} />
  </section>

  <section class="panel">
    <h2>MCP paid tool retry shape</h2>
    <p>
      Paid MCP tools mirror the HTTP x402 flow. First invocation returns payment metadata; retry
      passes the signed payload as <code>paymentSignature</code> (tool argument, not an HTTP header).
    </p>
    <CodeBlock
      code={`// 1) canix_list_opportunities({ limit: 10 })\n//    -> PAYMENT_REQUIRED + paymentRequiredHeader metadata\n\n// 2) canix_list_opportunities({\n//      limit: 10,\n//      paymentSignature: "<base64-json-payload>"\n//    })\n//    -> opportunity data`}
    />
  </section>

  <section class="panel">
    <h2>Signed retry shape (HTTP)</h2>
    <p>The website does not sign payments. Your agent/client wallet must build this payload.</p>
    <CodeBlock
      code={`{\n  "x402Version": 2,\n  "scheme": "exact",\n  "network": "algorand-mainnet",\n  "accepted": { /* selected accept option from PAYMENT-REQUIRED */ },\n  "payload": {\n    "paymentGroup": ["<base64-signed-txn>"],\n    "paymentIndex": 0\n  },\n  "paymentRequired": { /* decoded PAYMENT-REQUIRED */ }\n}`}
    />
  </section>

  <h2 id="sample-responses" class="page-title">Sample response payloads</h2>
  <div class="notice">
    These are illustrative snapshots of the normalized response contract, not live paid data.
    Opportunity rows include <code>executionShapes</code>, <code>compatibleExitShapes</code>, and
    (for Réti) <code>entryRequirements</code> / <code>capacity</code>. Numeric values follow the
    precision contract (6 decimal places by default, up to 12 for small non-zero values). Live
    responses vary in values and row count; the shape and field semantics match. The full
    machine-readable schema and examples are published in
    <a href={config.openApiUrl}>OpenAPI</a>.
  </div>

  <section class="panel">
    <h2>Aggregated opportunities</h2>
    <p><code>GET /opportunities</code> — top opportunities across all protocols, ranked by APY.</p>
    <CodeBlock code={`curl -i ${config.gatewayBaseUrl}/opportunities`} />
    <h3>Sample response (200)</h3>
    <CodeBlock code={format(aggregateSample)} />
  </section>

  <section class="panel">
    <h2>Filtered search</h2>
    <p><code>GET /opportunities/search</code> — caller-filtered opportunities by platform, type, APY, and TVL.</p>
    <CodeBlock
      code={`curl -i '${config.gatewayBaseUrl}/opportunities/search?platform=tinyman&minApy=0.05'`}
    />
    <h3>Sample response (200)</h3>
    <CodeBlock code={format(searchSample)} />
  </section>

  <section class="panel">
    <h2>Wallet-personalized opportunities</h2>
    <p>
      <code>GET /opportunities/personalized</code> — opportunities tuned to a wallet's held assets.
      Matching applies <code>POST /eligibility</code> rules so full or gated venues are not
      recommended as enterable. Rows include <code>canEnter</code> and
      <code>eligibilityFullyCheckable</code>; <code>meta.eligibilityEndpoint</code> is
      <code>/eligibility</code>.
    </p>
    <CodeBlock
      code={`curl -i '${config.gatewayBaseUrl}/opportunities/personalized?address=YOUR_ALGORAND_ADDRESS'`}
    />
    <h3>Sample response (200)</h3>
    <CodeBlock code={format(personalizedSample)} />
  </section>

  <section class="panel">
    <h2>Eligibility and capacity</h2>
    <p>
      <code>POST /eligibility</code> — check whether a wallet can enter selected opportunities
      before quoting. Returns <code>canEnter</code>, <code>missingAssets</code>,
      <code>gates</code>, <code>capacity</code>, and optional <code>suggestedSwap</code>.
      NFD/creator gates stay unresolved (<code>eligibilityFullyCheckable: false</code>).
    </p>
    <CodeBlock code={eligibilityCurl} />
    <h3>Sample response (200)</h3>
    <CodeBlock code={format(eligibilitySample)} />
  </section>

  <section class="panel">
    <h2>Intent compiler (paid)</h2>
    <p>
      <code>POST /plans</code> — flagship compiler SKU (~0.25 USDC). State an allocation intent
      (address, budget/asset, constraints). Returns ordered steps: eligibility, optional swap hints,
      protocol setup chains, and enter quotes as independent unsigned groups (never merged).
      Reuses <code>quotes[]</code> / <code>order</code> / <code>prerequisiteShapeKeys</code>.
      Brownie and other agents should consume this route rather than forking a compiler.
      Canix never signs or submits.
    </p>
    <CodeBlock code={plansCurl} />
    <h3>Sample response (200)</h3>
    <CodeBlock code={format(plansSample)} />
  </section>

  <section class="panel">
    <h2>Protocol-specific opportunities</h2>
    <p>
      <code>GET /protocols/&#123;protocol&#125;/opportunities</code> — opportunities for a single
      protocol. Substitute any supported protocol (e.g. <code>tinyman</code>, <code>pact</code>,
      <code>folks-finance</code>, <code>compx</code>, <code>dorkfi</code>, <code>myth-finance</code>,
      <code>haystack</code>, <code>reti</code>, <code>alpha-arcade</code>).
    </p>
    <CodeBlock code={`curl -i ${config.gatewayBaseUrl}/protocols/reti/opportunities`} />
    <h3>Sample response (200)</h3>
    <CodeBlock code={format(protocolSample)} />
  </section>

  <section class="panel">
    <h2>Execution shape catalog (free)</h2>
    <p>
      <code>GET /execution/shapes</code> — live catalog of verified shape keys, required inputs, and
      docs paths. Metadata only; does not compile quotes. <code>meta.caveatsDocsPath</code> points at
      protocol-specific construction caveats so agents do not guess pool discovery, opt-ins,
      min-balance, slippage, or app upgrades.
    </p>
    <CodeBlock code={`curl -s ${config.gatewayBaseUrl}/execution/shapes | jq '.meta, (.data | length)'`} />
    <h3>Sample response (200, trimmed)</h3>
    <CodeBlock code={format(executionShapesSample)} />
  </section>

  <section class="panel">
    <h2>Execution quotes (paid)</h2>
    <p>
      <code>POST /execution/quotes</code> — batch <code>&#123; quotes: [&#123; shapeKey, input &#125;, ...] &#125;</code>
      (~0.1 USDC flat per request). Returns unsigned groups; Canix never signs or submits.
      Preflight returns <code>402</code> with <code>PAYMENT-REQUIRED</code>; retry with
      <code>PAYMENT-SIGNATURE</code> (same pattern as opportunities).
    </p>
    <h3>1) Preflight (expect 402)</h3>
    <CodeBlock
      code={`curl -i ${config.gatewayBaseUrl}/execution/quotes \\\n  -H 'content-type: application/json' \\\n  -d '{\n    "quotes": [{\n      "shapeKey": "mainnet:tinyman:v2:addLiquidity:flexible",\n      "input": {\n        "userAddress": "YOUR_ALGORAND_ADDRESS",\n        "assetAId": 0,\n        "assetAAmount": "1000000",\n        "assetBId": 31566704,\n        "assetBAmount": "1000000",\n        "maxSlippageBps": 50\n      }\n    }]\n  }'`}
    />
    <h3>2) Paid retry (enter liquidity)</h3>
    <CodeBlock
      code={`curl -i ${config.gatewayBaseUrl}/execution/quotes \\\n  -H 'content-type: application/json' \\\n  -H 'PAYMENT-SIGNATURE: <base64-json-payload>' \\\n  -d '{\n    "quotes": [{\n      "shapeKey": "mainnet:tinyman:v2:addLiquidity:flexible",\n      "input": {\n        "userAddress": "YOUR_ALGORAND_ADDRESS",\n        "assetAId": 0,\n        "assetAAmount": "1000000",\n        "assetBId": 31566704,\n        "assetBAmount": "1000000",\n        "maxSlippageBps": 50\n      }\n    }]\n  }'`}
    />
    <h3>3) Exit from a position (use compatibleExitShapeKeys)</h3>
    <p>
      After <code>GET /positions</code>, pick a key from <code>compatibleExitShapeKeys</code> and
      fill inputs from that row's <code>inputHints</code> (plus amounts you choose locally).
    </p>
    <CodeBlock
      code={`curl -i ${config.gatewayBaseUrl}/execution/quotes \\\n  -H 'content-type: application/json' \\\n  -H 'PAYMENT-SIGNATURE: <base64-json-payload>' \\\n  -d '{\n    "quotes": [{\n      "shapeKey": "mainnet:tinyman:v2:removeLiquidity:multipleAssetsOut",\n      "input": {\n        "userAddress": "YOUR_ALGORAND_ADDRESS",\n        "poolId": "1002541853",\n        "assetAId": 0,\n        "assetBId": 31566704,\n        "poolTokenAmount": "1250000",\n        "maxSlippageBps": 50\n      }\n    }]\n  }'`}
    />
    <h3>Sample response (200)</h3>
    <CodeBlock code={format(executionQuotesSample)} />
  </section>

  <section class="panel">
    <h2>Wallet positions (paid)</h2>
    <p>
      <code>GET /positions?address=</code> — normalized DeFi positions with
      <code>compatibleExitShapeKeys</code> / <code>compatibleManageShapeKeys</code>
      (~0.005 USDC). Use those keys with <code>POST /execution/quotes</code> to exit or manage.
    </p>
    <h3>1) Preflight (expect 402)</h3>
    <CodeBlock
      code={`curl -i '${config.gatewayBaseUrl}/positions?address=YOUR_ALGORAND_ADDRESS'`}
    />
    <h3>2) Paid retry</h3>
    <CodeBlock
      code={`curl -i '${config.gatewayBaseUrl}/positions?address=YOUR_ALGORAND_ADDRESS' \\\n  -H 'PAYMENT-SIGNATURE: <base64-json-payload>'`}
    />
    <h3>Sample response (200)</h3>
    <CodeBlock code={format(positionsSample)} />
  </section>

  <section class="panel">
    <h2>Claim desk (paid)</h2>
    <p>
      <code>GET /positions/claimable?address=</code> — claimable rewards with USD value,
      network-fee / worth-claiming hints, and <code>claimAllQuotes</code> ready for
      <code>POST /execution/quotes</code> (~0.001 USDC list; compile stays ~0.10 USDC flat).
      Groups are never merged. Agent loop: positions (optional) → claimable → quote → local sign.
    </p>
    <h3>1) Preflight (expect 402)</h3>
    <CodeBlock
      code={`curl -i '${config.gatewayBaseUrl}/positions/claimable?address=YOUR_ALGORAND_ADDRESS'`}
    />
    <h3>2) Paid retry</h3>
    <CodeBlock
      code={`curl -i '${config.gatewayBaseUrl}/positions/claimable?address=YOUR_ALGORAND_ADDRESS' \\\n  -H 'PAYMENT-SIGNATURE: <base64-json-payload>'`}
    />
    <h3>3) Compile claim-all (use claimAllQuotes)</h3>
    <CodeBlock
      code={`curl -i ${config.gatewayBaseUrl}/execution/quotes \\\n  -H 'content-type: application/json' \\\n  -H 'PAYMENT-SIGNATURE: <base64-json-payload>' \\\n  -d '{\n    "quotes": [\n      {\n        "shapeKey": "mainnet:haystack:v1:claim:rewards",\n        "input": { "userAddress": "YOUR_ALGORAND_ADDRESS" }\n      },\n      {\n        "shapeKey": "mainnet:compx:v1:claim:rewards",\n        "input": { "userAddress": "YOUR_ALGORAND_ADDRESS", "poolAppId": 123456 }\n      }\n    ]\n  }'`}
    />
    <h3>Sample response (200)</h3>
    <CodeBlock code={format(positionsClaimableSample)} />
  </section>

  <section class="panel">
    <h2>Haystack swaps (quote → opt-in → paid transactions)</h2>
    <p>
      Walletless swap flow. Amounts are integer asset base units. Free quote and opt-in; paid
      <code>POST /swaps/transactions</code> (~0.005 USDC). Canix never signs or submits.
    </p>
    <h3>1) Free quote</h3>
    <CodeBlock
      code={`curl -i ${config.gatewayBaseUrl}/swaps/quote \\\n  -H 'content-type: application/json' \\\n  -d '{\n    "address": "YOUR_ALGORAND_ADDRESS",\n    "fromAssetId": 0,\n    "toAssetId": 31566704,\n    "amount": "1000000",\n    "type": "fixed-input"\n  }'`}
    />
    <h3>Sample quote response (200)</h3>
    <CodeBlock code={format(swapsQuoteSample)} />
    <h3>2) Free opt-in (pass quote unchanged)</h3>
    <CodeBlock
      code={`curl -i ${config.gatewayBaseUrl}/swaps/optin \\\n  -H 'content-type: application/json' \\\n  -d '{\n    "address": "YOUR_ALGORAND_ADDRESS",\n    "quote": { /* full data object from /swaps/quote */ }\n  }'`}
    />
    <h3>Sample opt-in response (200)</h3>
    <CodeBlock code={format(swapsOptinSample)} />
    <p class="muted">
      If <code>transactions</code> is non-empty, sign and submit locally, wait for confirmation, then
      fetch a <strong>fresh</strong> quote before the paid step.
    </p>
    <h3>3) Paid transactions — preflight (expect 402)</h3>
    <CodeBlock
      code={`curl -i ${config.gatewayBaseUrl}/swaps/transactions \\\n  -H 'content-type: application/json' \\\n  -d '{\n    "address": "YOUR_ALGORAND_ADDRESS",\n    "quote": { /* fresh quote data object */ },\n    "slippage": 0.005\n  }'`}
    />
    <h3>4) Paid transactions — retry with PAYMENT-SIGNATURE</h3>
    <CodeBlock
      code={`curl -i ${config.gatewayBaseUrl}/swaps/transactions \\\n  -H 'content-type: application/json' \\\n  -H 'PAYMENT-SIGNATURE: <base64-json-payload>' \\\n  -d '{\n    "address": "YOUR_ALGORAND_ADDRESS",\n    "quote": { /* fresh quote data object */ },\n    "slippage": 0.005\n  }'`}
    />
    <h3>Sample transactions response (200)</h3>
    <CodeBlock code={format(swapsTransactionsSample)} />
    <p class="muted">
      Sign only <code>userSignIndexes</code>, keep Haystack pre-signed members and group order, then
      submit the complete atomic group through your own Algod client.
    </p>
  </section>

  <section class="panel">
    <h2>Error responses</h2>
    <p>Paid routes return <code>402</code> before payment; validation and server errors use a stable envelope.</p>
    <h3>402 — payment required</h3>
    <CodeBlock
      code={`{\n  "error": {\n    "code": "MISSING_PAYMENT_SIGNATURE",\n    "message": "The paid endpoint was called without PAYMENT-SIGNATURE."\n  }\n}`}
    />
    <h3>400 — invalid Algorand address (personalized route)</h3>
    <CodeBlock
      code={`{\n  "error": {\n    "code": "VALIDATION_ERROR",\n    "message": "Query parameter 'address' is not a valid Algorand address."\n  }\n}`}
    />
  </section>
</BaseLayout>
