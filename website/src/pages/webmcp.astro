---
import BaseLayout from "../layouts/BaseLayout.astro";
import WebmcpToolField from "../components/WebmcpToolField.astro";
import { config } from "../lib/config";
import { WEBMCP_TOOLS } from "../lib/webmcp/catalog";
import { fieldsForSchema } from "../lib/webmcp/tool-forms";
import {
  HUMAN_CHECKOUT_TOOLS,
  WEBMCP_TOOL_GROUPS,
  toolFillsTable,
  toolsInGroup,
} from "../lib/webmcp/tool-groups";

const freeCount = WEBMCP_TOOLS.filter((tool) => tool.access === "free").length;
const paidCount = WEBMCP_TOOLS.length - freeCount;
---

<BaseLayout
  title="WebMCP | CANIX402"
  description="Canix402 WebMCP: fill an opportunities table from the same MCP tools agents discover in-page. Walletless receipts, no signing or submission."
  keywords="Canix402 WebMCP, navigator.modelContext, document.modelContext, registerTool, MCP tools, x402, Algorand opportunities"
>
  <meta
    slot="head"
    http-equiv="Permissions-Policy"
    content="tools=(self), document-domain=()"
  />

  <div class="webmcp-page-head">
    <div>
      <h1 class="page-title">Canix402 Live</h1>
      <p class="page-lead">
        Search live DeFi opportunities. Available for agents, humans
        and agents on the web.
      </p>
    </div>
    <button
      type="button"
      class="button button-primary webmcp-tools-open"
      data-open-tools
      aria-expanded="false"
      aria-controls="webmcp-tools-drawer"
    >
      Tools
    </button>
  </div>

  <section class="panel webmcp-session-bar" data-webmcp-checkout>
    <div class="webmcp-session-bar-copy">
      <h2>Pre-paid session for humans</h2>
      <p class="muted">
        Connect Pera, Defly, or a Base wallet, pay once, then call the paid tools.
      </p>
    </div>
    <div class="webmcp-wallet-row">
      <button type="button" class="button" data-connect="pera">
        <img data-connect-icon alt="" hidden width="20" height="20" />
        <span data-connect-label>Connect Pera</span>
      </button>
      <button type="button" class="button" data-connect="defly">
        <img data-connect-icon alt="" hidden width="20" height="20" />
        <span data-connect-label>Connect Defly</span>
      </button>
      <div class="webmcp-wallet-group" data-base-wallets></div>
      <button type="button" class="button button-ghost" data-disconnect hidden
        >Disconnect</button
      >
      <button
        type="button"
        class="button button-primary"
        data-buy-session
        disabled
      >
        Buy session
      </button>
      <button type="button" class="button" data-refresh-session disabled>
        Refresh
      </button>
    </div>
    <div class="webmcp-status-grid webmcp-session-meta">
      <div class="webmcp-status-card">
        <p class="muted">Wallet</p>
        <p class="webmcp-status-value" data-wallet-status>Disconnected</p>
        <p class="muted mono" data-wallet-address>Not connected</p>
      </div>
      <div class="webmcp-status-card" aria-live="polite">
        <p class="muted">Remaining</p>
        <p class="webmcp-status-value">
          <span data-remaining-research>—</span>
          <span class="muted">research</span>
        </p>
        <p class="webmcp-status-value">
          <span data-remaining-quotes>—</span>
          <span class="muted">quotes</span>
        </p>
        <p class="muted" data-session-expires hidden>—</p>
      </div>
    </div>
    <p class="webmcp-checkout-note" data-checkout-note hidden></p>
    <pre class="code-block webmcp-checkout-error" data-checkout-error hidden>
    </pre>
  </section>

  <section class="panel webmcp-opportunities" data-webmcp-opportunities>
    <div class="webmcp-opportunities-toolbar">
      <h2>Opportunities</h2>
      <div class="webmcp-opportunities-actions">
        <button type="button" class="button" data-list-top-opportunities>
          Get top 25
        </button>

        <button
          type="button"
          class="button button-primary webmcp-tools-open-inline"
          data-open-tools
        >
          Tools
        </button>
      </div>
    </div>
    <div class="webmcp-tool-table-wrap">
      <table
        class="endpoint-table webmcp-opportunities-table"
        data-opportunities-table
        aria-busy="false"
      >
        <thead>
          <tr>
            <th class="webmcp-select-col">
              <span class="visually-hidden">Select</span>
            </th>
            <th>Protocol</th>
            <th>Type</th>
            <th>Assets</th>
            <th>APY</th>
            <th>TVL</th>
            <th>Ready</th>
            <th>Enter</th>
            <th>ID</th>
          </tr>
        </thead>
        <tbody data-opportunities-body>
          <tr data-opportunities-empty>
            <td colspan="9">
              <div class="webmcp-empty">
                <p class="muted">No opportunities loaded</p>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <button
    type="button"
    class="button button-primary webmcp-tools-fab"
    data-open-tools
    aria-expanded="false"
    aria-controls="webmcp-tools-drawer"
  >
    Tools
  </button>

  <div class="webmcp-tools-overlay" data-tools-overlay hidden></div>
  <aside
    class="webmcp-tools-drawer"
    id="webmcp-tools-drawer"
    data-webmcp-tools-drawer
    data-webmcp-tool-list
    data-webmcp-run
    role="dialog"
    aria-modal="true"
    aria-labelledby="webmcp-tools-title"
    hidden
  >
    <div class="webmcp-tools-drawer-head">
      <div>
        <h2 id="webmcp-tools-title">Tools</h2>
        <p class="muted">
          {WEBMCP_TOOLS.length} MCP tools. Opportunity tools fill the table.
        </p>
      </div>
      <button type="button" class="button button-ghost" data-close-tools
        >Close</button
      >
    </div>
    <div class="webmcp-field webmcp-tools-filter">
      <label for="webmcp-tool-filter">Filter tools</label>
      <input
        id="webmcp-tool-filter"
        type="search"
        data-tool-filter
        placeholder="search, plan, tinyman…"
      />
    </div>
    <div class="webmcp-tools-drawer-body">
      {
        WEBMCP_TOOL_GROUPS.map((group) => (
          <section class="webmcp-tool-group" data-tool-group={group.id}>
            <h3>{group.label}</h3>
            <p class="muted">{group.hint}</p>
            {toolsInGroup(group).map((tool) => {
              const checkoutOnly = HUMAN_CHECKOUT_TOOLS.has(tool.name);
              const fields = checkoutOnly
                ? []
                : fieldsForSchema(tool.inputSchema);
              return (
                <details
                  class="webmcp-tool-card"
                  data-webmcp-tool={tool.name}
                  data-access={tool.access}
                  {...(tool.name === "canix_search_opportunities"
                    ? { open: true }
                    : {})}
                >
                  <summary>
                    <span class="webmcp-tool-summary">
                      <code>{tool.name}</code>
                      <span
                        class={`badge ${tool.access === "paid" ? "badge-paid" : "badge-free"}`}
                      >
                        {tool.access}
                        {tool.fallbackPriceUsdc
                          ? ` · ${tool.fallbackPriceUsdc} USDC`
                          : ""}
                      </span>
                      <span
                        class="badge badge-free"
                        data-webmcp-registration="pending"
                      >
                        Catalog
                      </span>
                    </span>
                  </summary>
                  <p class="muted webmcp-tool-description">
                    {tool.description}
                  </p>
                  <p class="muted">
                    <span class="badge badge-method">{tool.http.method}</span>
                    <code class="webmcp-http-path">{tool.http.path}</code>
                  </p>
                  {checkoutOnly ? (
                    <p class="muted">
                      Humans buy or refresh a session in the bar on this page.
                      Agents call this tool with per-request USDC.
                    </p>
                  ) : (
                    <form
                      data-tool-form={tool.name}
                      data-fills-table={
                        toolFillsTable(tool.name) ? "true" : "false"
                      }
                    >
                      {fields.map((field) => (
                        <WebmcpToolField field={field} toolName={tool.name} />
                      ))}
                      <button type="submit" class="button button-primary">
                        Run {tool.name}
                      </button>
                    </form>
                  )}
                </details>
              );
            })}
          </section>
        ))
      }
    </div>
    <div class="webmcp-tools-drawer-result">
      <p class="webmcp-checkout-note" data-run-note hidden></p>
      <pre class="code-block webmcp-run-result" data-run-result hidden></pre>
      <pre class="code-block webmcp-checkout-error" data-run-error hidden></pre>
    </div>
  </aside>

  <div
    id="webmcp-root"
    hidden
    data-gateway={config.gatewayBaseUrl}
    data-nfd-api={config.nfdApiBaseUrl}
  >
  </div>

  <script>
    import { registerCanixWebMcpTools } from "../lib/webmcp/register";
    import { mountWebmcpPage } from "../lib/webmcp/page-app";

    const root = document.querySelector<HTMLElement>("#webmcp-root");
    const gateway = root?.dataset.gateway ?? "";
    const nfdApiBaseUrl = root?.dataset.nfdApi ?? "";

    const status = await registerCanixWebMcpTools({ gatewayBaseUrl: gateway });
    const registered = new Set(status.registered);

    document
      .querySelectorAll<HTMLElement>("[data-webmcp-tool]")
      .forEach((row) => {
        const name = row.dataset.webmcpTool ?? "";
        const badge = row.querySelector<HTMLElement>(
          "[data-webmcp-registration]",
        );
        if (!badge) {
          return;
        }
        if (registered.has(name)) {
          badge.textContent = "Registered";
          badge.className = "badge badge-free";
          badge.dataset.webmcpRegistration = "registered";
        } else if (status.api === "unavailable") {
          badge.textContent = "Catalog only";
          badge.dataset.webmcpRegistration = "catalog";
        } else {
          const failure = status.failed.find((item) => item.name === name);
          badge.textContent = failure ? "Failed" : "Not registered";
          badge.className = "badge badge-paid";
          badge.dataset.webmcpRegistration = "failed";
        }
      });

    await mountWebmcpPage({ gatewayBaseUrl: gateway, nfdApiBaseUrl });
  </script>
</BaseLayout>
