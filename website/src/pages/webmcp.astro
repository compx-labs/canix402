---
import BaseLayout from "../layouts/BaseLayout.astro";
import WebmcpConnectModal from "../components/WebmcpConnectModal.astro";
import WebmcpToolField from "../components/WebmcpToolField.astro";
import { config } from "../lib/config";
import { getWebMcpTool, WEBMCP_TOOLS } from "../lib/webmcp/catalog";
import { fieldsForSchema } from "../lib/webmcp/tool-forms";
import {
  advancedToolGroups,
  HUMAN_CHECKOUT_TOOLS,
  HUMAN_TOOL_GROUPS,
  humanToolsInGroup,
  sessionUseLabel,
  toolFillsTable,
  toolPriceLabel,
  toolsInGroup,
} from "../lib/webmcp/tool-groups";

const sessionPrice = getWebMcpTool("canix_create_session")?.fallbackPriceUsdc ?? "0.25";

function firstSentence(text: string): string {
  const match = text.match(/^.*?[.!?](?:\s|$)/);
  return (match?.[0] ?? text).trim();
}
---

<BaseLayout
  title="Live | CANIX402"
  description="Canix402 Live: search DeFi opportunities in the browser with the same MCP tools agents use. Walletless receipts, no server-side signing or submission."
  keywords="Canix402 WebMCP, navigator.modelContext, document.modelContext, registerTool, MCP tools, x402, Algorand opportunities"
>
  <meta
    slot="head"
    http-equiv="Permissions-Policy"
    content="tools=(self), document-domain=()"
  />

  <div class="webmcp-page-head">
    <div>
      <h1 class="page-title">Live</h1>
      <p class="page-lead">
        Search live DeFi opportunities. Available for agents, humans
        and agents on the web.
      </p>
    </div>
  </div>

  <section class="panel webmcp-session-bar" data-webmcp-checkout>
    <div class="webmcp-session-head">
      <div class="webmcp-session-bar-copy">
        <h2>Session</h2>
        <p class="muted">
          One USDC payment unlocks research calls and plans or quotes for 4 hours. No per-call signing.
        </p>
      </div>
      <div class="webmcp-wallet-slot">
        <button type="button" class="button button-primary" data-open-connect>
          Connect wallet
        </button>
        <div class="webmcp-wallet-chip" data-wallet-chip hidden>
          <button
            type="button"
            class="webmcp-chip-button"
            data-chip-toggle
            aria-haspopup="menu"
            aria-expanded="false"
          >
            <img data-wallet-icon alt="" hidden width="20" height="20" />
            <span class="webmcp-chip-address" data-wallet-address>Not connected</span>
            <span class="badge badge-free" data-wallet-network>Algorand</span>
          </button>
          <div class="webmcp-chip-menu" data-chip-menu role="menu" hidden>
            <button type="button" role="menuitem" data-copy-address>Copy address</button>
            <button type="button" role="menuitem" data-switch-wallet>Switch wallet</button>
            <button type="button" role="menuitem" data-disconnect>Disconnect</button>
          </div>
        </div>
      </div>
    </div>

    <p class="webmcp-session-hint" data-session-hint>Connect a wallet first.</p>
    <div class="webmcp-session-meters" data-session-meters hidden>
      <div>
        <div class="webmcp-meter-label">
          <span>Research</span>
          <span data-remaining-research>—</span>
        </div>
        <div class="webmcp-meter" aria-hidden="true">
          <span class="webmcp-meter-fill" data-meter-research></span>
        </div>
      </div>
      <div>
        <div class="webmcp-meter-label">
          <span>Quotes</span>
          <span data-remaining-quotes>—</span>
        </div>
        <div class="webmcp-meter" aria-hidden="true">
          <span class="webmcp-meter-fill" data-meter-quotes></span>
        </div>
      </div>
      <p class="muted" data-session-expires hidden>—</p>
    </div>
    <div class="webmcp-session-actions">
      <button
        type="button"
        class="button button-primary"
        data-buy-session
        data-session-price={sessionPrice}
        disabled
      >
        Buy session · ~{sessionPrice} USDC
      </button>
      <button type="button" class="button" data-refresh-session hidden>Refresh session</button>
    </div>
    <p class="muted webmcp-session-reassure">
      Canix never signs or submits on your behalf. Your wallet is only used to pay for the session.
    </p>
    <p class="webmcp-checkout-note" data-checkout-note hidden></p>
    <div class="webmcp-alert webmcp-alert-error" data-checkout-error hidden>
      <p data-error-text></p>
      <details>
        <summary>Details</summary>
        <pre class="code-block" data-error-json></pre>
      </details>
    </div>
  </section>

  <section class="panel webmcp-opportunities" data-webmcp-opportunities>
    <div class="webmcp-opportunities-toolbar">
      <h2>Opportunities</h2>
      <div class="webmcp-opportunities-actions">
        <button type="button" class="button" data-list-top-opportunities>
          Get top 25
        </button>
        <span class="muted webmcp-selection-count" data-selection-count hidden>0 selected</span>
        <button type="button" class="button" data-check-eligibility disabled>
          Check eligibility
        </button>
        <button type="button" class="button" data-get-plan disabled>Build plan</button>
        <button type="button" class="button button-ghost" data-clear-opportunities disabled>
          Clear
        </button>
        <button
          type="button"
          class="button button-primary webmcp-tools-open-inline"
          data-open-tools
          aria-expanded="false"
          aria-controls="webmcp-tools-drawer"
        >
          Tools
        </button>
      </div>
    </div>
    <p class="webmcp-checkout-note" data-table-note hidden></p>
    <div class="webmcp-tool-table-wrap">
      <table
        class="endpoint-table webmcp-opportunities-table"
        data-opportunities-table
        aria-busy="false"
      >
        <thead>
          <tr>
            <th class="webmcp-select-col">
              <span class="visually-hidden">Select</span>
            </th>
            <th>Protocol</th>
            <th>Type</th>
            <th>Assets</th>
            <th>APY</th>
            <th>TVL</th>
            <th>Ready</th>
            <th>Enter</th>
            <th>ID</th>
          </tr>
        </thead>
        <tbody data-opportunities-body>
          <tr data-opportunities-empty>
            <td colspan="9">
              <div class="webmcp-empty">
                <p class="muted">No opportunities loaded</p>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <button
    type="button"
    class="button button-primary webmcp-tools-fab"
    data-open-tools
    aria-expanded="false"
    aria-controls="webmcp-tools-drawer"
  >
    Tools
  </button>

  <div class="webmcp-tools-overlay" data-tools-overlay hidden></div>
  <aside
    class="webmcp-tools-drawer"
    id="webmcp-tools-drawer"
    data-webmcp-tools-drawer
    data-webmcp-tool-list
    data-webmcp-run
    role="dialog"
    aria-modal="true"
    aria-labelledby="webmcp-tools-title"
    hidden
  >
    <div class="webmcp-tools-drawer-head">
      <div>
        <h2 id="webmcp-tools-title">Tools</h2>
        <p class="muted">Pick a tool. Opportunity results fill the table.</p>
      </div>
      <button type="button" class="button button-ghost" data-close-tools>Close</button>
    </div>
    <div class="webmcp-tools-layout">
      <div class="webmcp-tools-list-pane" data-tool-list-pane>
        <div class="webmcp-field webmcp-tools-filter" data-tool-filter-wrap>
          <label for="webmcp-tool-filter">Filter tools</label>
          <input
            id="webmcp-tool-filter"
            type="search"
            data-tool-filter
            placeholder="search, plan, positions…"
          />
        </div>
        {
          HUMAN_TOOL_GROUPS.map((group) => (
            <section class="webmcp-human-group" data-human-group={group.id}>
              <h3>{group.label}</h3>
              {humanToolsInGroup(group.id).map((entry) => (
                <button
                  type="button"
                  class="webmcp-tool-row"
                  data-select-tool={entry.name}
                  data-tool-search={`${entry.title} ${entry.blurb} ${entry.name}`.toLowerCase()}
                >
                  <span class="webmcp-tool-row-top">
                    <span class="webmcp-tool-row-title">{entry.title}</span>
                    <span
                      class={`badge ${toolPriceLabel(entry.name) === "Free" ? "badge-free" : "badge-paid"}`}
                      data-tool-cost
                    >
                      {toolPriceLabel(entry.name)}
                    </span>
                  </span>
                  <span class="muted webmcp-tool-row-blurb">{entry.blurb}</span>
                </button>
              ))}
            </section>
          ))
        }
        <details class="webmcp-advanced" data-advanced-tools>
          <summary>Advanced: all MCP tools</summary>
          {
            advancedToolGroups().map((group) => (
              <section class="webmcp-tool-group" data-tool-group={group.id}>
                <h3>{group.label}</h3>
                {toolsInGroup(group).map((tool) => {
                  const checkoutOnly = HUMAN_CHECKOUT_TOOLS.has(tool.name);
                  const fields = checkoutOnly ? [] : fieldsForSchema(tool.inputSchema);
                  return (
                    <details class="webmcp-tool-card" data-webmcp-tool={tool.name}>
                      <summary>
                        <span class="webmcp-tool-summary">
                          <code>{tool.name}</code>
                          <span
                            class={`badge ${tool.access === "paid" ? "badge-paid" : "badge-free"}`}
                          >
                            {toolPriceLabel(tool.name)}
                          </span>
                        </span>
                      </summary>
                      <p class="muted webmcp-tool-description">{firstSentence(tool.description)}</p>
                      {checkoutOnly ? (
                        <p class="muted">
                          Buy or refresh a session from the session card. Agents call this tool with per-request USDC.
                        </p>
                      ) : (
                        <form
                          data-tool-form={tool.name}
                          data-fills-table={toolFillsTable(tool.name) ? "true" : "false"}
                        >
                          {fields.map((field) => (
                            <WebmcpToolField field={field} toolName={tool.name} />
                          ))}
                          <button type="submit" class="button button-primary">
                            Run
                          </button>
                        </form>
                      )}
                    </details>
                  );
                })}
              </section>
            ))
          }
        </details>
        <p class="muted webmcp-registration-summary" data-registration-summary data-tool-count={WEBMCP_TOOLS.length}>
        </p>
      </div>
      <div class="webmcp-tools-form-pane" data-tool-form-pane>
        <button type="button" class="button button-ghost button-small webmcp-tool-back" data-tool-back>
          All tools
        </button>
        <p class="muted webmcp-tool-placeholder" data-tool-placeholder>
          Choose a tool to run it here.
        </p>
        {
          HUMAN_TOOL_GROUPS.flatMap((group) => humanToolsInGroup(group.id)).map((entry) => {
            const tool = getWebMcpTool(entry.name);
            if (!tool) {
              return null;
            }
            const fields = fieldsForSchema(tool.inputSchema);
            const usage = sessionUseLabel(entry.name);
            return (
              <form
                data-tool-form={entry.name}
                data-fills-table={toolFillsTable(entry.name) ? "true" : "false"}
                hidden
              >
                <div class="webmcp-tool-form-head">
                  <h3>{entry.title}</h3>
                  <p class="muted">{entry.blurb}</p>
                  {usage ? <p class="webmcp-tool-usage">{usage}</p> : null}
                </div>
                {fields.map((field) => (
                  <WebmcpToolField field={field} toolName={entry.name} />
                ))}
                <button type="submit" class="button button-primary">
                  Run
                </button>
              </form>
            );
          })
        }
        <div class="webmcp-tools-drawer-result">
          <p class="webmcp-checkout-note" data-run-note hidden></p>
          <div data-run-result-wrap hidden>
            <div class="webmcp-result-toolbar">
              <span>Result</span>
              <button type="button" class="button button-ghost button-small" data-copy-result>
                Copy JSON
              </button>
            </div>
            <pre class="code-block webmcp-run-result" data-run-result></pre>
          </div>
          <div class="webmcp-alert webmcp-alert-error" data-run-error hidden>
            <p data-error-text></p>
            <details>
              <summary>Details</summary>
              <pre class="code-block" data-error-json></pre>
            </details>
          </div>
        </div>
      </div>
    </div>
  </aside>

  <WebmcpConnectModal />

  <div
    id="webmcp-root"
    hidden
    data-gateway={config.gatewayBaseUrl}
    data-nfd-api={config.nfdApiBaseUrl}
  >
  </div>

  <script>
    import { registerCanixWebMcpTools } from "../lib/webmcp/register";
    import { mountWebmcpPage } from "../lib/webmcp/page-app";

    const root = document.querySelector<HTMLElement>("#webmcp-root");
    const gateway = root?.dataset.gateway ?? "";
    const nfdApiBaseUrl = root?.dataset.nfdApi ?? "";

    const status = await registerCanixWebMcpTools({ gatewayBaseUrl: gateway });
    const summary = document.querySelector<HTMLElement>("[data-registration-summary]");
    if (summary) {
      const count = Number(summary.dataset.toolCount ?? "0");
      if (status.api === "unavailable") {
        summary.textContent = `${count} tools in the catalog. This browser cannot register them for on-page agents.`;
      } else if (status.failed.length > 0) {
        summary.textContent = `${status.registered.length} of ${count} tools registered for on-page agents.`;
      } else {
        summary.textContent = `${count} tools registered for on-page agents.`;
      }
    }

    await mountWebmcpPage({ gatewayBaseUrl: gateway, nfdApiBaseUrl });
  </script>
</BaseLayout>
