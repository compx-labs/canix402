---
import BaseLayout from "../layouts/BaseLayout.astro";
import { protocols } from "../lib/protocols";
---

<BaseLayout
  title="Protocols | CANIX402"
  description="See which Algorand DeFi protocols Canix402 covers — Tinyman, Pact, Folks Finance, CompX, Dork.fi, Myth Finance, Haystack, and Réti — and how each source is normalized into a shared opportunity schema."
  keywords="Canix402 protocols, Tinyman, Pact, Folks Finance, CompX, Dork.fi, Myth Finance, Haystack, Réti, Algorand DeFi coverage"
>
  <h1 class="page-title">Supported protocols</h1>
  <p class="muted">
    canix402 normalizes all supported sources into a shared opportunity schema. Detailed adapter
    contracts live in the protocol repo under <code>protocol/docs/data-sources/</code>.
  </p>

  <div class="card-grid">
    {
      protocols.map((protocol) => (
        <article class="card protocol-detail-card">
          <div class="protocol-card-header">
            <img
              class:list={[
                "protocol-logo",
                protocol.logoVariant === "wide" && "protocol-logo--wide"
              ]}
              src={protocol.logo}
              alt=""
              width="40"
              height="40"
              loading="lazy"
              decoding="async"
            />
            <h3>{protocol.name}</h3>
          </div>
          <p>{protocol.summary}</p>
          <p class="muted">{protocol.notes}</p>
        </article>
      ))
    }
  </div>
</BaseLayout>
