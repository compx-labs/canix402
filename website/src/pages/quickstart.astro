---
import BaseLayout from "../layouts/BaseLayout.astro";
import CodeBlock from "../components/CodeBlock.astro";
import PaymentFlow from "../components/PaymentFlow.astro";
import { config } from "../lib/config";
---

<BaseLayout title="Quickstart | CANIX402" description="Four-step agent onboarding for canix402.">
  <h1 class="page-title">Quickstart</h1>
  <p class="muted">
    Use the Caddy gateway URL as your base URL. Discovery and OpenAPI are free; paid data routes
    require x402 USDC payment.
  </p>

  <section class="panel">
    <h2>1. Read discovery</h2>
    <p>Fetch the machine-readable endpoint catalog and payment policy.</p>
    <CodeBlock code={`curl -s ${config.discoveryUrl} | jq`} />
  </section>

  <section class="panel">
    <h2>2. Read OpenAPI</h2>
    <p>Use OpenAPI for detailed schemas, query params, and x402 metadata.</p>
    <CodeBlock code={`curl -s ${config.openApiUrl} | jq '.paths | keys'`} />
  </section>

  <section class="panel">
    <h2>3. Probe free routes</h2>
    <p>Health and metadata routes should return <code>200</code> without payment headers.</p>
    <CodeBlock code={`curl -i ${config.gatewayBaseUrl}/health\ncurl -i ${config.gatewayBaseUrl}/metadata`} />
  </section>

  <section class="panel">
    <h2>4. Call a paid route</h2>
    <p>First call returns <code>402</code> with <code>PAYMENT-REQUIRED</code>. Retry with a signed payload.</p>
    <PaymentFlow />
    <CodeBlock
      code={`curl -i ${config.gatewayBaseUrl}/opportunities\n\ncurl -i ${config.gatewayBaseUrl}/opportunities \\\n  -H 'PAYMENT-SIGNATURE: <base64-json-payload>'`}
    />
  </section>
</BaseLayout>
