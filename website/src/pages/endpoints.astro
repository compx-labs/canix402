---
import BaseLayout from "../layouts/BaseLayout.astro";
import EndpointTable from "../components/EndpointTable.astro";
import { catalogEndpoints } from "../lib/catalog-endpoints";
import { config } from "../lib/config";
import { loadDiscovery } from "../lib/discovery";

const loaded = await loadDiscovery(config.discoveryUrl);
const endpoints = catalogEndpoints(loaded.document.endpoints);
const paidCount = endpoints.filter((endpoint) => endpoint.access === "paid").length;
---

<BaseLayout
  title="Endpoints | CANIX402"
  description="Browse the Canix402 endpoint catalog: free discovery and OpenAPI routes, plus x402-paid opportunity APIs with per-route USDC pricing sourced from live discovery metadata."
  keywords="Canix402 endpoints, API catalog, x402 pricing, discovery metadata, OpenAPI, paid routes, free routes"
>
  <div class="section-header">
    <span class="eyebrow">API catalog</span>
    <h1 class="page-title">Endpoints</h1>
    <p class="page-lead">
      Browse Canix402 routes as individual cards — method, access, pricing, and parameters at a glance.
      Inventory is sourced from discovery metadata and stays aligned with the live gateway contract.
    </p>
    <p class="muted">
      Live source: <a href={config.discoveryUrl}>{config.discoveryUrl}</a>
      <span aria-hidden="true"> · </span>
      <span class="badge badge-live">{endpoints.length} APIs live</span>
      <span aria-hidden="true"> · </span>
      <span class="badge badge-paid">{paidCount} paid</span>
    </p>
  </div>

  {
    loaded.source === "snapshot" && (
      <div class="notice">
        Using checked-in sample discovery metadata because live discovery was unavailable at build time.
      </div>
    )
  }

  <EndpointTable endpoints={endpoints} />

  <section class="panel">
    <h2>OpenAPI contract</h2>
    <p class="muted">
      Detailed operation schemas, request parameters, and response shapes are published at
      <a href={config.openApiUrl}>{config.openApiUrl}</a>.
    </p>
  </section>
</BaseLayout>
