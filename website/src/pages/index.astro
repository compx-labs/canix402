---
import BaseLayout from "../layouts/BaseLayout.astro";
import BrandLogo from "../components/BrandLogo.astro";
import CodeBlock from "../components/CodeBlock.astro";
import HumanPrompt from "../components/HumanPrompt.astro";
import { config } from "../lib/config";
import { protocols } from "../lib/protocols";
import { getLatestReleaseNote } from "../lib/release-notes";

const latestRelease = await getLatestReleaseNote();
const mcpConfig = `{
  "mcpServers": {
    "canix402": {
      "url": "${config.mcpUrl}"
    }
  }
}`;
---

<BaseLayout
  title="CANIX402 | Hunting down the best yields"
  description="Canix402 is one paid API for normalized DeFi yield on Algorand and Base. Copy a prompt into your agent, or search live in the browser."
  keywords="Canix402, Algorand DeFi API, Base, x402 payments, autonomous agents, APY, yield hunting, MCP"
>
  <section class="landing-hero">
    <div class="landing-hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">x402 paid DeFi data API</span>
        <h1>Hunting down the best yields</h1>
        <p class="hero-lead">
          One paid API for normalized DeFi yield on Algorand and Base, for an agent or in the browser.
        </p>
        <div class="cta-row">
          <a class="button button-primary" href="#human">Copy prompt</a>
          <a class="button" href="/webmcp">Open Live</a>
        </div>
      </div>
      <div class="hero-banner">
        <BrandLogo variant="mark" class="hero-mark" alt="CANIX402 wolf mark" />
      </div>
    </div>
  </section>

  <HumanPrompt />

  <section class="landing-section">
    <div class="section-header">
      <span class="eyebrow">For agents</span>
      <h2>Already have a host?</h2>
      <p class="section-lead muted">
        Connect the Canix MCP server, then follow the agent steps on
        <a href="/quickstart#agent">Get started</a>.
      </p>
    </div>
    <CodeBlock code={mcpConfig} />
  </section>

  <section class="landing-section">
    <div class="section-header">
      <span class="eyebrow">What it is</span>
      <h2>What Canix does</h2>
      <p class="section-lead muted">
        Normalized yield and unsigned execution across Algorand and Base, paid in USDC, signed by
        the caller. One schema for every supported protocol.
      </p>
    </div>
  </section>

  <section class="landing-section">
    <div class="section-header">
      <span class="eyebrow">Proof</span>
      <h2>Already running</h2>
    </div>
    <ul class="proof-list">
      <li>
        <a href="/user-agents">Brownie Bot</a> uses Canix on Algorand mainnet.
      </li>
      <li>
        <a href="/transactions">Recent USDC payments</a> to the Canix pay-to wallet.
      </li>
    </ul>
  </section>

  <section class="landing-section" id="protocols">
    <div class="section-header">
      <span class="eyebrow">Coverage</span>
      <h2>Protocols</h2>
    </div>
    <ul class="protocol-strip">
      {
        protocols.map((protocol) => (
          <li>
            <a href="/protocols">
              <img
                class:list={[
                  "protocol-logo protocol-logo--grid",
                  protocol.logoVariant === "wide" && "protocol-logo--wide"
                ]}
                src={protocol.logo}
                alt=""
                width="36"
                height="36"
                loading="lazy"
                decoding="async"
              />
              <span>{protocol.name}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="protocol-foot muted">
      Notes for each protocol are on <a href="/protocols">protocols</a>. Routes are on
      <a href="/endpoints">endpoints</a>.
    </p>
  </section>

  <p class="hero-release">
    Latest: <a href="/release-notes">protocol v{latestRelease.data.version} release notes</a>
  </p>

  <section class="cta-band">
    <div class="cta-band-inner">
      <h2>Get your agent Canix-ready</h2>
      <div class="cta-row">
        <a class="button button-primary" href="#human">Copy prompt</a>
        <a class="button" href="/webmcp">Open Live</a>
      </div>
    </div>
  </section>
</BaseLayout>
