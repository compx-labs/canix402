---
import BaseLayout from "../layouts/BaseLayout.astro";
import { config } from "../lib/config";
---

<BaseLayout
  title="Live Transactions | CANIX402"
  description="Live inbound USDC payments to the CANIX402 x402 pay-to wallet. Shows recent under-1-USDC settlements with totals and NFD sender names, refreshed every 2 minutes."
  keywords="Canix402 transactions, x402 payments, USDC, Algorand, live payments, pay-to wallet, NFD"
>
  <h1 class="page-title">Live Transactions</h1>
  <p class="muted page-lead">
    Inbound USDC payments received by the CANIX402 Algorand x402 pay-to wallet. Only payments
    under 1 USDC are shown. Totals cover this recent window (not lifetime history).
    Data is sourced from the Algorand Indexer and refreshed every 2 minutes. Base settlements
    are a separate rail and do not appear here. Agents may pay on either rail. An Algorand-only
    agent does not need a Base address.
  </p>

  <div class="transactions-meta panel">
    <p>
      <strong>Pay-to wallet:</strong>
      <code id="pay-to-address" class="transactions-address" title={config.payToAddress}>
        {config.payToAddress}
      </code>
    </p>
    <p id="transactions-status" class="transactions-status muted" aria-live="polite">
      Loading transactions…
    </p>
  </div>

  <div
    id="transactions-stats"
    class="transactions-stats"
    aria-label="Totals for the recent under-1-USDC payment window"
    hidden
  >
    <div class="transactions-stat">
      <span class="transactions-stat-label">Payments shown</span>
      <span id="stat-count" class="transactions-stat-value">—</span>
    </div>
    <div class="transactions-stat">
      <span class="transactions-stat-label">Total USDC</span>
      <span id="stat-total" class="transactions-stat-value">—</span>
    </div>
    <div class="transactions-stat">
      <span class="transactions-stat-label">Unique senders</span>
      <span id="stat-senders" class="transactions-stat-value">—</span>
    </div>
    <div class="transactions-stat">
      <span class="transactions-stat-label">Largest payment</span>
      <span id="stat-largest" class="transactions-stat-value">—</span>
    </div>
  </div>
  <p class="muted transactions-stats-note">
    Totals reflect the recent under-1-USDC window loaded below — not all-time volume.
  </p>

  <div class="transactions-table-wrap">
    <table class="endpoint-table transactions-table" aria-label="Recent inbound USDC payments">
      <thead>
        <tr>
          <th>Time</th>
          <th>Amount</th>
          <th>Sender</th>
          <th>Round</th>
          <th>Transaction</th>
        </tr>
      </thead>
      <tbody id="transactions-body">
        <tr>
          <td colspan="5" class="muted">Loading…</td>
        </tr>
      </tbody>
    </table>
  </div>
</BaseLayout>

<script
  is:inline
  define:vars={{
    txPageConfig: JSON.stringify({
      payToAddress: config.payToAddress,
      usdcAssetId: config.usdcAssetId,
      indexerUrl: config.indexerBaseUrl,
      nfdApiBaseUrl: config.nfdApiBaseUrl,
      txExplorerBase: config.alloTxBaseUrl,
      pollMs: config.transactionsRefreshMs
    })
  }}
>
  const {
    payToAddress,
    usdcAssetId,
    indexerUrl,
    nfdApiBaseUrl,
    txExplorerBase,
    pollMs
  } = JSON.parse(txPageConfig);
  const ONE_USDC_MICRO = 1_000_000;
  const MAX_ROWS = 30;
  const PAGE_SIZE = 50;
  const MAX_PAGES = 10;
  const NFD_BATCH_SIZE = 20;
  /** @type {ReturnType<typeof setInterval> | null} */
  let refreshTimer = null;
  /** @type {Map<string, string | null>} */
  const nfdCache = new Map();

  /**
   * @param {string} address
   */
  function truncateAddress(address) {
    if (address.length <= 16) return address;
    return `${address.slice(0, 8)}…${address.slice(-8)}`;
  }

  /**
   * @param {number} microUsdc
   */
  function formatUsdc(microUsdc) {
    const value = microUsdc / ONE_USDC_MICRO;
    return `${value.toLocaleString(undefined, {
      minimumFractionDigits: 2,
      maximumFractionDigits: 6
    })} USDC`;
  }

  /**
   * @param {number} unixSeconds
   */
  function formatTime(unixSeconds) {
    return new Date(unixSeconds * 1000).toLocaleString(undefined, {
      dateStyle: "medium",
      timeStyle: "short"
    });
  }

  /**
   * @param {string} txid
   */
  function alloTxUrl(txid) {
    return `${txExplorerBase}/${txid}`;
  }

  /**
   * @param {string} value
   */
  function escapeHtml(value) {
    return value
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#39;");
  }

  /**
   * @param {Record<string, unknown>} txn
   */
  function isValidInboundPayment(txn) {
    if (txn["tx-type"] !== "axfer") return false;

    const transfer = /** @type {Record<string, unknown> | undefined} */ (
      txn["asset-transfer-transaction"]
    );
    if (!transfer) return false;

    const receiver = transfer.receiver;
    const assetId = String(transfer["asset-id"] ?? "");
    const amount = Number(transfer.amount ?? 0);

    if (!payToAddress || receiver !== payToAddress) return false;
    if (!usdcAssetId || assetId !== usdcAssetId) return false;
    if (amount <= 0 || amount >= ONE_USDC_MICRO) return false;

    return true;
  }

  /**
   * @param {Record<string, unknown>} txn
   */
  function toRow(txn) {
    const transfer = /** @type {Record<string, unknown>} */ (
      txn["asset-transfer-transaction"]
    );
    const txid = String(txn.id ?? "");
    const sender = String(txn.sender ?? "");
    const round = Number(txn["confirmed-round"] ?? 0);
    const roundTime = Number(txn["round-time"] ?? 0);
    const amount = Number(transfer.amount ?? 0);

    return {
      txid,
      sender,
      round,
      roundTime,
      amount,
      url: alloTxUrl(txid),
      nfdName: /** @type {string | null} */ (null)
    };
  }

  /**
   * @param {string} message
   * @param {boolean} [isError]
   */
  function setStatus(message, isError = false) {
    const statusEl = document.getElementById("transactions-status");
    if (!statusEl) return;
    statusEl.textContent = message;
    statusEl.classList.toggle("transactions-status-error", isError);
  }

  /**
   * @param {string} message
   */
  function renderEmpty(message) {
    const tbody = document.getElementById("transactions-body");
    if (!tbody) return;
    tbody.innerHTML = `<tr><td colspan="5" class="muted">${escapeHtml(message)}</td></tr>`;
  }

  /**
   * @param {Array<{ amount: number; sender: string }>} rows
   */
  function renderStats(rows) {
    const statsEl = document.getElementById("transactions-stats");
    const countEl = document.getElementById("stat-count");
    const totalEl = document.getElementById("stat-total");
    const sendersEl = document.getElementById("stat-senders");
    const largestEl = document.getElementById("stat-largest");
    if (!statsEl || !countEl || !totalEl || !sendersEl || !largestEl) return;

    if (rows.length === 0) {
      statsEl.hidden = true;
      return;
    }

    const totalMicro = rows.reduce((sum, row) => sum + row.amount, 0);
    const uniqueSenders = new Set(rows.map((row) => row.sender)).size;
    const largestMicro = Math.max(...rows.map((row) => row.amount));

    countEl.textContent = rows.length.toLocaleString();
    totalEl.textContent = formatUsdc(totalMicro);
    sendersEl.textContent = uniqueSenders.toLocaleString();
    largestEl.textContent = formatUsdc(largestMicro);
    statsEl.hidden = false;
  }

  /**
   * @param {string} sender
   * @param {string | null} nfdName
   */
  function formatSenderCell(sender, nfdName) {
    const safeSender = escapeHtml(sender);
    if (nfdName) {
      const safeName = escapeHtml(nfdName);
      return `<span class="transactions-nfd" title="${safeSender}">${safeName}</span>`;
    }
    return `<code class="transactions-address" title="${safeSender}">${escapeHtml(truncateAddress(sender))}</code>`;
  }

  /**
   * @param {Array<{ txid: string; sender: string; round: number; roundTime: number; amount: number; url: string; nfdName: string | null }>} rows
   */
  function renderRows(rows) {
    const tbody = document.getElementById("transactions-body");
    if (!tbody) return;

    if (rows.length === 0) {
      renderEmpty("No inbound USDC payments under 1 USDC found.");
      return;
    }

    tbody.innerHTML = rows
      .map(
        (row) => `<tr>
          <td>${formatTime(row.roundTime)}</td>
          <td>${formatUsdc(row.amount)}</td>
          <td>${formatSenderCell(row.sender, row.nfdName)}</td>
          <td>${row.round.toLocaleString()}</td>
          <td><a href="${escapeHtml(row.url)}" target="_blank" rel="noopener noreferrer">${escapeHtml(truncateAddress(row.txid))}</a></td>
        </tr>`
      )
      .join("");
  }

  /**
   * @param {string[]} addresses
   */
  async function lookupNfdBatch(addresses) {
    if (addresses.length === 0) return;

    const params = new URLSearchParams({ view: "tiny" });
    for (const address of addresses) {
      params.append("address", address);
    }

    const url = `${nfdApiBaseUrl.replace(/\/$/, "")}/nfd/lookup?${params.toString()}`;
    try {
      const response = await fetch(url);
      if (response.status === 404) {
        for (const address of addresses) {
          nfdCache.set(address, null);
        }
        return;
      }
      if (!response.ok) {
        for (const address of addresses) {
          if (!nfdCache.has(address)) nfdCache.set(address, null);
        }
        return;
      }

      const payload = await response.json();
      if (typeof payload !== "object" || payload === null || Array.isArray(payload)) {
        for (const address of addresses) {
          nfdCache.set(address, null);
        }
        return;
      }

      for (const address of addresses) {
        const entry = /** @type {Record<string, unknown> | undefined} */ (
          payload[address]
        );
        const name =
          entry && typeof entry.name === "string" && entry.name.length > 0
            ? entry.name
            : null;
        nfdCache.set(address, name);
      }
    } catch {
      for (const address of addresses) {
        if (!nfdCache.has(address)) nfdCache.set(address, null);
      }
    }
  }

  /**
   * @param {string[]} addresses
   */
  async function resolveNfdNames(addresses) {
    const unique = [...new Set(addresses.filter(Boolean))];
    const missing = unique.filter((address) => !nfdCache.has(address));

    for (let index = 0; index < missing.length; index += NFD_BATCH_SIZE) {
      await lookupNfdBatch(missing.slice(index, index + NFD_BATCH_SIZE));
    }

    return nfdCache;
  }

  async function fetchTransactions() {
    /** @type {Array<ReturnType<typeof toRow>>} */
    const collected = [];
    /** @type {string | undefined} */
    let nextToken;

    for (let page = 0; page < MAX_PAGES && collected.length < MAX_ROWS; page += 1) {
      const params = new URLSearchParams({
        "asset-id": usdcAssetId,
        "tx-type": "axfer",
        "address-role": "receiver",
        "currency-greater-than": "0",
        "currency-less-than": String(ONE_USDC_MICRO),
        limit: String(PAGE_SIZE)
      });

      if (nextToken) {
        params.set("next", nextToken);
      }

      const url = `${indexerUrl}/v2/accounts/${payToAddress}/transactions?${params.toString()}`;
      const response = await fetch(url);
      if (!response.ok) {
        throw new Error(`Indexer request failed (${response.status})`);
      }

      const payload = await response.json();
      const transactions = Array.isArray(payload.transactions) ? payload.transactions : [];

      for (const txn of transactions) {
        if (isValidInboundPayment(txn)) {
          collected.push(toRow(txn));
          if (collected.length >= MAX_ROWS) break;
        }
      }

      nextToken = payload["next-token"];
      if (!nextToken || transactions.length === 0) break;
    }

    return collected.slice(0, MAX_ROWS);
  }

  async function refreshTransactions() {
    try {
      setStatus("Fetching latest transactions…");
      const rows = await fetchTransactions();
      renderStats(rows);
      renderRows(rows);

      const totalMicro = rows.reduce((sum, row) => sum + row.amount, 0);
      const refreshedAt = new Date().toLocaleString(undefined, {
        dateStyle: "medium",
        timeStyle: "short"
      });
      setStatus(
        rows.length === 0
          ? `No payments under 1 USDC in this window. Last refreshed ${refreshedAt}.`
          : `Showing ${rows.length} payment${rows.length === 1 ? "" : "s"} totaling ${formatUsdc(totalMicro)}. Last refreshed ${refreshedAt}.`
      );

      if (rows.length > 0) {
        await resolveNfdNames(rows.map((row) => row.sender));
        for (const row of rows) {
          row.nfdName = nfdCache.get(row.sender) ?? null;
        }
        renderRows(rows);
      }
    } catch (error) {
      const message = error instanceof Error ? error.message : "Unknown error";
      setStatus(`Unable to load transactions: ${message}`, true);
      renderStats([]);
      renderEmpty("Unable to load transactions.");
    }
  }

  function startAutoRefresh() {
    if (refreshTimer) {
      clearInterval(refreshTimer);
    }
    refreshTimer = setInterval(refreshTransactions, pollMs);
  }

  refreshTransactions();
  startAutoRefresh();

  document.addEventListener("visibilitychange", () => {
    if (document.visibilityState === "visible") {
      refreshTransactions();
    }
  });
</script>
