        "path": "/opportunities/search",
        "access": "paid",
        "summary": "Caller-filtered opportunities across supported platforms",
        "description": "Returns Algorand DeFi opportunities filtered by platform, opportunity type, APY range, and TVL threshold across supported sources. Use when an agent needs targeted discovery such as high-yield liquidity pools, lending markets, protocol-specific yield, or minimum-liquidity opportunities on Algorand. This endpoint provides normalized market data only; it does not build or submit transactions.",
        "tags": [
          "defi",
          "opportunities",
          "search"
        ],
        "pathParams": [],
        "queryParams": [
          "platform",
          "type",
          "minApy",
          "maxApy",
          "minTvlUsd",
          "limit",
          "offset",
          "includeInactive"
