      {
        "id": "haystackSwapQuote",
        "method": "POST",
        "path": "/swaps/quote",
        "access": "free",
        "summary": "Fetch a walletless Haystack swap quote",
        "description": "Returns a serializable Haystack route quote for an Algorand swap without signing or submitting transactions. Amounts use asset base units. Quotes are short-lived and should be refreshed after completing prerequisite opt-ins.",
        "tags": [
          "defi",
          "swaps",
          "haystack",
          "agents"
        ],
        "pathParams": [],
        "queryParams": [],
        "responseCodes": [
          200,
          400,
          429,
          502
        ]
      },
      {
        "id": "haystackSwapOptIn",
        "method": "POST",
        "path": "/swaps/optin",
        "access": "free",
        "summary": "Build prerequisite Haystack swap opt-ins",
        "description": "Inspects the supplied account and quote, then returns any required output-asset and application opt-in transactions as an unsigned group. The caller signs and submits the group locally; canix402 never receives wallet keys or submits it.",
        "tags": [
          "defi",
          "swaps",
          "haystack",
          "transactions",
          "wallet"
        ],
        "pathParams": [],
        "queryParams": [],
        "responseCodes": [
