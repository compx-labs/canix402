---
import type { ToolFormField } from "../lib/webmcp/tool-forms";

interface Props {
  field: ToolFormField;
  toolName: string;
}

const { field, toolName } = Astro.props;
const id = `webmcp-${toolName}-${field.name.replaceAll(".", "-")}`;
const hint = firstSentence(field.description);
const isAddress = field.name === "address" || field.name.toLowerCase().endsWith("address");
const isOpportunityIds = field.name === "opportunityIds";

function firstSentence(text: string | undefined): string | undefined {
  if (!text) {
    return undefined;
  }
  const match = text.match(/^.*?[.!?](?:\s|$)/);
  return (match?.[0] ?? text).trim();
}
---

<div class="webmcp-field">
  {
    field.kind === "checkbox" ? (
      <label class="webmcp-field-check" for={id}>
        <input id={id} name={field.name} type="checkbox" />
        <span>
          {field.label}
          {hint ? <small class="muted">{hint}</small> : null}
        </span>
      </label>
    ) : (
      <>
        <div class="webmcp-field-label-row">
          <label for={id}>
            {field.label}
            {field.required ? <span class="webmcp-required">*</span> : null}
          </label>
          {isAddress ? (
            <button type="button" class="button button-ghost button-small" data-use-wallet>
              Use connected wallet
            </button>
          ) : null}
          {isOpportunityIds ? (
            <button type="button" class="button button-ghost button-small" data-use-selected disabled>
              Use selected rows
            </button>
          ) : null}
        </div>
        {hint ? <p class="muted webmcp-field-hint">{hint}</p> : null}
        {field.kind === "select" ? (
          <select id={id} name={field.name} required={field.required}>
            <option value="">{field.required ? "Select…" : "Any"}</option>
            {field.options?.map((option) => (
              <option value={option}>{option}</option>
            ))}
          </select>
        ) : field.kind === "json" ? (
          <textarea
            id={id}
            name={field.name}
            rows={field.rows ?? 6}
            required={field.required}
            spellcheck="false"
            placeholder={field.placeholder}
          />
        ) : (
          <input
            id={id}
            name={field.name}
            type={field.kind === "number" ? "number" : "text"}
            inputmode={field.kind === "number" ? "decimal" : undefined}
            required={field.required}
            min={field.min}
            max={field.max}
            step={field.kind === "number" ? "any" : undefined}
            placeholder={field.placeholder}
            value={field.defaultValue}
          />
        )}
      </>
    )
  }
</div>
