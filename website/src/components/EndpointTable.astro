---
import { formatEndpointPrice, type DiscoveryEndpoint } from "../lib/discovery";

interface Props {
  endpoints: DiscoveryEndpoint[];
}

const { endpoints } = Astro.props;
---

<div class="panel">
  <table class="endpoint-table">
    <thead>
      <tr>
        <th>Method</th>
        <th>Path</th>
        <th>Access</th>
        <th>Summary</th>
        <th>Pricing</th>
      </tr>
    </thead>
    <tbody>
      {
        endpoints.map((endpoint) => (
          <tr>
            <td><code>{endpoint.method}</code></td>
            <td><code>{endpoint.path}</code></td>
            <td>
              <span class={`badge ${endpoint.access === "paid" ? "badge-paid" : "badge-free"}`}>
                {endpoint.access}
              </span>
            </td>
            <td>{endpoint.summary}</td>
            <td>{formatEndpointPrice(endpoint)}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
