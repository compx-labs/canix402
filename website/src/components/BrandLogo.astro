---
interface Props {
  variant?: "banner" | "mark";
  alt?: string;
  class?: string;
}

const {
  variant = "mark",
  alt = "CANIX402",
  class: className = ""
} = Astro.props;

const src = variant === "banner" ? "/brand/canix402-banner-v2.png" : "/brand/canix402-mark-v2.png";
---

<img src={src} alt={alt} class={className} loading="eager" />
