# Caddy listener (separate from API). App Platform terminates TLS/routing before
# the container, so bind Caddy to the service port rather than the public domain.
CADDY_SITE_ADDRESS=:8080
# Local dev: http://localhost:3000
# DO App Platform (internal): http://<protocol-component-name>:3000
UPSTREAM_API=http://localhost:3000

# Facilitator (GoPlausible by default)
FACILITATOR_URL=https://facilitator.goplausible.xyz

# x402 accept policy — pay_to and every price below are REQUIRED in production.
# If any price var is missing, Caddy fails to start (Caddyfile parse error on
# the empty `price` directive). Set all of these on the Caddy App Platform component.
X402_PAY_TO=REPLACE_WITH_PAYTO_ADDRESS

# Per-route x402 prices (USDC). Must match Caddyfile `accept { price ... }` blocks.
X402_PRICE_AGGREGATE_USDC=0.01
X402_PRICE_SEARCH_USDC=0.01
X402_PRICE_PERSONALIZED_USDC=0.05
X402_PRICE_HISTORY_USDC=0.01
X402_PRICE_ELIGIBILITY_USDC=0.01
X402_PRICE_PLANS_USDC=0.25
X402_PRICE_PLANS_REBALANCE_USDC=0.25
X402_PRICE_POLICY_VALIDATE_USDC=0.25
X402_PRICE_POSITIONS_USDC=0.005
X402_PRICE_POSITIONS_CLAIMABLE_USDC=0.001
X402_PRICE_PROTOCOL_USDC=0.01
X402_PRICE_EXECUTION_QUOTE_USDC=0.1
X402_PRICE_EXECUTION_COMPOSE_USDC=0.1
X402_PRICE_EXECUTION_SIMULATE_USDC=0.1
# Paid POST /swaps/transactions and /swaps/folks/transactions; quote and opt-in routes are free.
# This access charge is separate from Haystack/Folks Router/DEX swap and Algorand network fees. # pragma: allowlist secret
X402_PRICE_HAYSTACK_SWAP_USDC=0.005
X402_PRICE_FOLKS_ROUTER_SWAP_USDC=0.005
X402_PRICE_SESSIONS_USDC=0.25
X402_PRICE_WATCH_USDC=0.25

X402_NETWORK=algorand-mainnet
X402_SCHEME=exact

# Reference identifiers for client/facilitator alignment
X402_USDC_ASSET_ID=31566704
X402_NETWORK_CAIP2=algorand:wGHE2Pwdvd7S12BL5FaOP20EGYesN73ktiC1qzkkit8=
