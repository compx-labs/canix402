			accept {
				pay_to {$X402_PAY_TO}
				price {$X402_PRICE_HAYSTACK_SWAP_USDC}
				network {$X402_NETWORK}
				scheme {$X402_SCHEME}
				extra {
					tag x402-global-challenge
				}
			}
		}

		reverse_proxy {$UPSTREAM_API}
	}

	handle {
		respond "not found" 404
	}
}
