				network {$X402_NETWORK}
				scheme {$X402_SCHEME}
				extra {
					tag x402-global-challenge
				}
			}
		}

		reverse_proxy {$UPSTREAM_API}
	}

	@paid_positions path /positions
	handle @paid_positions {
		x402 {
			description "canix402 wallet DeFi positions endpoint"
			mime_type application/json
			facilitator_url {$FACILITATOR_URL}
			bazaar_profile positions

			accept {
				pay_to {$X402_PAY_TO}
				price {$X402_PRICE_POSITIONS_USDC}
				network {$X402_NETWORK}
				scheme {$X402_SCHEME}
				extra {
					tag x402-global-challenge
				}
			}
		}

		reverse_proxy {$UPSTREAM_API}
	}

	@paid_protocol path /protocols/*/opportunities
	handle @paid_protocol {
		x402 {
			description "canix402 paid DeFi data endpoint"
			mime_type application/json
			facilitator_url {$FACILITATOR_URL}
			bazaar_profile protocol_opportunities

			accept {
				pay_to {$X402_PAY_TO}
