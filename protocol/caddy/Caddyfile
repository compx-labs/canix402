{
	order x402 before reverse_proxy
}

{$CADDY_SITE_ADDRESS} {
	header {
		Access-Control-Allow-Origin *
		Access-Control-Allow-Methods "GET, POST, OPTIONS"
		Access-Control-Allow-Headers "Content-Type, PAYMENT-SIGNATURE, PAYMENT-REQUIRED, PAYMENT-RESPONSE, X-Canix-Session"
	}

	@options {
		method OPTIONS
	}
	handle @options {
		respond 204
	}

	@free {
		method GET
		path / /health /ready /metadata /discovery /openapi.json /llms.txt /llms-full.txt /robots.txt /favicon.ico /favicon.png /logo.png /banner.png /.well-known/x402 /.well-known/x402.json /.well-known/agent-card.json /.well-known/agent.json /.well-known/ai-plugin.json /swaps/quote /swaps/optin /pricing /execution/shapes /public/agents/brownie/positions /sessions/*
	}
	handle @free {
		reverse_proxy {$UPSTREAM_API}
	}

	@free_post {
		method POST
		path /swaps/quote /swaps/optin /pricing
	}
	handle @free_post {
		reverse_proxy {$UPSTREAM_API}
	}

	@session {
		header X-Canix-Session *
		path /opportunities /opportunities/search /opportunities/personalized /eligibility /plans /plans/rebalance /positions /positions/claimable /protocols/*/opportunities /swaps/transactions /execution/quotes /execution/compose /execution/simulate
	}
	handle @session {
		reverse_proxy {$UPSTREAM_API}
	}

	@paid_aggregate path /opportunities
	handle @paid_aggregate {
		x402 {
			description "canix402 paid DeFi data endpoint"
			mime_type application/json
			facilitator_url {$FACILITATOR_URL}
			bazaar_profile opportunities

			accept {
				pay_to {$X402_PAY_TO}
				price {$X402_PRICE_AGGREGATE_USDC}
				network {$X402_NETWORK}
				scheme {$X402_SCHEME}
				extra {
					tag x402-global-challenge
				}
			}
		}

		reverse_proxy {$UPSTREAM_API}
	}

	@paid_search path /opportunities/search
	handle @paid_search {
