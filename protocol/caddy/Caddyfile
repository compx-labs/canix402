{
	order x402 before reverse_proxy
}

{$CADDY_SITE_ADDRESS} {
	@free path /health /metadata /discovery /openapi.json /.well-known/x402.json
	handle @free {
		reverse_proxy {$UPSTREAM_API}
	}

	@paid_aggregate path /opportunities
	handle @paid_aggregate {
		x402 {
			description "canix402 paid DeFi data endpoint"
			mime_type application/json
			facilitator_url {$FACILITATOR_URL}

			accept {
				pay_to {$X402_PAY_TO}
				price {$X402_PRICE_AGGREGATE_USDC}
				network {$X402_NETWORK}
				scheme {$X402_SCHEME}
			}
		}

		reverse_proxy {$UPSTREAM_API}
	}

	@paid_search path /opportunities/search
	handle @paid_search {
		x402 {
			description "canix402 paid DeFi data endpoint"
			mime_type application/json
			facilitator_url {$FACILITATOR_URL}

			accept {
				pay_to {$X402_PAY_TO}
				price {$X402_PRICE_SEARCH_USDC}
				network {$X402_NETWORK}
				scheme {$X402_SCHEME}
			}
		}

		reverse_proxy {$UPSTREAM_API}
	}

	@paid_personalized path /opportunities/personalized
	handle @paid_personalized {
		x402 {
			description "canix402 wallet-personalized DeFi data endpoint"
			mime_type application/json
			facilitator_url {$FACILITATOR_URL}

			accept {
				pay_to {$X402_PAY_TO}
				price {$X402_PRICE_PERSONALIZED_USDC}
				network {$X402_NETWORK}
				scheme {$X402_SCHEME}
			}
		}

		reverse_proxy {$UPSTREAM_API}
	}

	@paid_protocol path /protocols/*/opportunities
	handle @paid_protocol {
		x402 {
			description "canix402 paid DeFi data endpoint"
			mime_type application/json
			facilitator_url {$FACILITATOR_URL}

			accept {
				pay_to {$X402_PAY_TO}
				price {$X402_PRICE_PROTOCOL_USDC}
				network {$X402_NETWORK}
				scheme {$X402_SCHEME}
			}
		}

		reverse_proxy {$UPSTREAM_API}
	}

	handle {
		respond "not found" 404
	}
}
