# Server/runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# x402 facilitator
X402_FACILITATOR_BASE_URL=
X402_FACILITATOR_API_KEY=
X402_RESOURCE_ID=algorand-defi-opportunities
X402_PUBLIC_BASE_URL=https://api.canix402.compx.io
X402_DOCS_URL=https://canix402.compx.io/x402

# USDC payment settings
X402_PAYMENT_ASSET=USDC
X402_PAYMENT_NETWORK=algorand-mainnet
X402_PAYMENT_AMOUNT_USDC=
X402_PAYMENT_RECEIVER_ADDRESS=

# Per-endpoint pricing overrides (USDC). Required on both components where noted.
#
# Protocol API (internal) — discovery/OpenAPI metadata only:
X402_PRICE_PERSONALIZED_USDC=0.05
X402_PRICE_POSITIONS_USDC=0.005
X402_PRICE_EXECUTION_QUOTE_USDC=0.1
X402_PRICE_HAYSTACK_SWAP_USDC=0.005
X402_PRICE_STRATEGY_PUBLISH_USDC=100
X402_PRICE_STRATEGY_REVISE_USDC=1
X402_PRICE_STRATEGY_COMPILE_USDC=0.1
#
# Caddy gateway (public) — edge enforcement; see protocol/caddy/.env.example for
# the full list. At minimum the Caddy component MUST also set:
#   X402_PRICE_EXECUTION_QUOTE_USDC=0.1
#   X402_PRICE_POSITIONS_USDC=0.005
#   X402_PRICE_HAYSTACK_SWAP_USDC=0.005
#   X402_PRICE_STRATEGY_PUBLISH_USDC=100
#   X402_PRICE_STRATEGY_REVISE_USDC=1
#   X402_PRICE_STRATEGY_COMPILE_USDC=0.1
# (and every other X402_PRICE_* var in caddy/.env.example) or Caddy will not start.

# Strategy marketplace persistence (DigitalOcean Spaces). If unset, uses local
# STRATEGY_DATA_DIR filesystem store and stub ASA ids for publish.
DO_SPACES_ENDPOINT=
DO_SPACES_REGION=nyc3
DO_SPACES_BUCKET=
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_PREFIX=canix402
STRATEGY_DATA_DIR=data/strategies
STRATEGY_MINT_MNEMONIC=
STRATEGY_PAYOUT_ADDRESS=
STRATEGY_PAYOUT_MNEMONIC=

# Nodely Caddy integration
NODELY_CADDY_BASE_URL=
NODELY_CADDY_API_KEY=
X402_GATEWAY_MODE=caddy
X402_GATEWAY_EXPECTED_HEADERS=PAYMENT-REQUIRED,PAYMENT-SIGNATURE,PAYMENT-RESPONSE
X402_USDC_ASSET_ID=31566704
X402_NETWORK_CAIP2=algorand:wGHE2Pwdvd7S12BL5FaOP20EGYesN73ktiC1qzkkit8=
X402_ALGOD_URL=https://mainnet-api.algonode.cloud
X402_ALGOD_TOKEN=
X402_INDEXER_URL=https://mainnet-idx.algonode.cloud
X402_INDEXER_TOKEN=
# Public RPC rate-limit controls. Positions share one Algod budget across
# bounded concurrent protocol collectors.
ALGOD_LOOKUP_CONCURRENCY=1
ALGOD_LOOKUP_DELAY_MS=150
ALGOD_429_MAX_RETRIES=2
ALGOD_429_RETRY_BASE_MS=250
POSITIONS_PROTOCOL_CONCURRENCY=2
POSITIONS_RPC_CONCURRENCY=2
POSITIONS_RPC_DELAY_MS=125
POSITIONS_HTTP_CONCURRENCY=2
POSITIONS_INDEXER_CONCURRENCY=2
POSITIONS_CATALOG_TTL_MS=300000

# Upstream data sources - Tinyman
TINYMAN_API_BASE_URL=
TINYMAN_POOL_VERSIONS=1.1,2.0
TINYMAN_ONLY_VERIFIED=true
TINYMAN_POOL_LIMIT=100

# Upstream data sources - Pact
PACT_API_BASE_URL=https://api.pact.fi/api
PACT_ONLY_VERIFIED=true

# Upstream data sources - CompX
COMPX_NETWORK=mainnet
COMPX_MASTER_REPO_APP_ID=
# Optional override; defaults to the CompX SDK's official pricing API.
COMPX_PRICING_API_URL=
COMPX_ONLY_ACTIVE=true

# Upstream data sources - Dork.fi
DORKFI_API_BASE_URL=https://dorkfi-static.nautilus.sh/dorkfi-opportunities-latest.json
DORKFI_API_KEY=
# Optional wallet health/position index; defaults to the public Dork.fi API.
DORKFI_INDEXED_API_BASE_URL=https://dorkfi-api.nautilus.sh

# Upstream data sources - Haystack
HAYSTACK_API_BASE_URL=https://hayrouter.txnlab.dev/api
HAYSTACK_API_KEY=
HAYSTACK_REFERRER_ADDRESS=
HAYSTACK_REQUEST_CONCURRENCY=2
HAYSTACK_REQUEST_DELAY_MS=100
HAYSTACK_429_MAX_RETRIES=2
HAYSTACK_429_RETRY_BASE_MS=250
# Haystack swap quotes use base-unit amounts and retain the SDK's default 10 bps
# output fee. That fee, DEX fees, and Algorand network fees are separate from the
# X402_PRICE_HAYSTACK_SWAP_USDC gateway charge.

# Live x402 paid integration test inputs
X402_CLIENT_MNEMONIC=

# Tinyman production liquidity tests (production gateway + on-chain submit)
# X402_TINYMAN_EXECUTION_LIVE=1
# X402_TINYMAN_EXECUTION_SCENARIO=roundtrip
# Scenarios: add | remove | roundtrip | singleAssetAdd | singleAssetOutRemove | singleAssetRoundtrip
# X402_TINYMAN_REMOVE_POOL_TOKEN_AMOUNT=
# X402_PRODUCTION_BASE_URL=https://canix402-api.compx.io

# Haystack production swap test (manual only; spends 0.1 USDC plus 0.005 USDC x402)
# X402_HAYSTACK_SWAP_LIVE=1
# X402_PRODUCTION_BASE_URL=https://canix402-api.compx.io

# Folks Finance production lending tests (production gateway + on-chain submit)
# X402_FOLKS_EXECUTION_LIVE=1
# X402_FOLKS_EXECUTION_SCENARIO=roundtrip
# Scenarios: deposit | withdraw | roundtrip
# X402_FOLKS_ESCROW_ADDRESS=
# X402_FOLKS_ASSET_ID=31566704
# X402_INDEXER_URL=https://mainnet-idx.algonode.cloud

# Folks Finance xALGO immediate stake/unstake (production gateway + on-chain submit)
# X402_FOLKS_XALGO_LIVE=1
# X402_FOLKS_XALGO_SCENARIO=roundtrip
# Scenarios: stake | unstake | roundtrip
# X402_FOLKS_XALGO_STAKE_AMOUNT=1000000
# X402_FOLKS_XALGO_UNSTAKE_AMOUNT=

# Production x402 paid test (manual only; never enable in CI)
# X402_PRODUCTION_PAID_TEST=1
# X402_PRODUCTION_BASE_URL=https://canix402-api.compx.io
# X402_PRODUCTION_PERSONALIZED_ADDRESS=3Y2V6ODUVUGM4TXOEXY65YLMKMVLG4PB3GSOXDCJDE4X5YQA5JA3P2FHAQ
