{
  "name": "protocol",
  "version": "1.0.0",
  "private": true,
  "description": "x402-gated Algorand DeFi opportunities data API",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "cli:opportunities": "tsx --env-file-if-exists=.env src/cli/opportunities.ts",
    "positions": "tsx --env-file-if-exists=.env src/cli/positions.ts",
    "sweep:usdc": "tsx --env-file-if-exists=.env src/cli/sweep-usdc.ts",
    "harvest:fees": "tsx --env-file-if-exists=.env src/cli/harvest-fees.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test tests/integration/*.test.ts",
    "test:api": "tsx --test tests/integration/*.test.ts",
    "test:gateway": "tsx --test tests/e2e/*.test.ts",
    "test:live": "tsx --test tests/live/tinyman-live.test.ts tests/live/pact-api-live.test.ts tests/live/pact-live.test.ts tests/live/x402-live.test.ts",
    "test:pact-live": "tsx --test tests/live/pact-api-live.test.ts tests/live/pact-live.test.ts",
    "test:x402-live": "tsx --test tests/live/x402-live.test.ts",
    "test:tinyman-production": "tsx --test tests/live/tinyman-production-test.test.ts",
    "test:tinyman-execution-live": "npm run test:tinyman-production",
    "test:pact-production": "tsx --test tests/live/pact-production-test.test.ts",
    "test:pact-execution-live": "npm run test:pact-production",
    "test:pact-farm-shape-live": "tsx --test tests/live/pact-farm-shape-live.test.ts",
    "test:pact-farm-production": "tsx --test tests/live/pact-farm-production-test.test.ts",
    "test:pact-farm-execution-live": "npm run test:pact-farm-production",
    "test:folks-production": "tsx --test tests/live/folks-finance-production-test.test.ts",
    "test:folks-execution-live": "npm run test:folks-production",
    "test:folks-xalgo-production": "tsx --test tests/live/folks-xalgo-production-test.test.ts",
    "test:folks-xalgo-execution-live": "npm run test:folks-xalgo-production",
    "test:compx-production": "tsx --test tests/live/compx-production-test.test.ts",
    "test:compx-execution-live": "npm run test:compx-production",
    "test:dorkfi-production": "tsx --test tests/live/dorkfi-production-test.test.ts",
    "test:dorkfi-execution-live": "npm run test:dorkfi-production",
    "test:myth-production": "tsx --test tests/live/myth-finance-production-test.test.ts",
    "test:myth-execution-live": "npm run test:myth-production",
    "test:x402-production": "tsx --test tests/live/x402-production.test.ts",
    "test:haystack-production": "tsx --test tests/live/haystack-production-swap.test.ts",
    "test:live:haystack-swap": "npm run test:haystack-production",
    "test:haystack-gold-quote": "tsx --test tests/live/haystack-gold-usdc-quote.test.ts",
    "test:live:haystack-gold-quote": "npm run test:haystack-gold-quote",
    "test:haystack-staking-production": "tsx --test tests/live/haystack-staking-production-test.test.ts",
    "test:haystack-staking-execution-live": "npm run test:haystack-staking-production",
    "test:alpha-arcade-staking-production": "tsx --test tests/live/alpha-arcade-staking-production-test.test.ts",
    "test:alpha-arcade-staking-execution-live": "npm run test:alpha-arcade-staking-production",
    "test:production-smoke": "tsx scripts/production-smoke.ts",
    "test:tinyman-live": "npm run test:live",
    "build:caddy-x402": "mkdir -p .bin && xcaddy build --output .bin/caddy-x402 --with github.com/algorandecosystem/caddy-x402avm=./caddy",
    "dev:caddy": ".bin/caddy-x402 run --config caddy/Caddyfile --adapter caddyfile",
    "test:x402-e2e": "tsx --test tests/e2e/*.test.ts",
    "test:ci": "npm run test:api && npm run test:gateway",
    "test:live:local": "tsx --test tests/live/x402-live.test.ts",
    "test:live:production": "tsx --test tests/live/x402-production.test.ts",
    "test:live:execution": "tsx --test tests/live/tinyman-production-test.test.ts",
    "test:live:folks-execution": "tsx --test tests/live/folks-finance-production-test.test.ts",
    "snapshot:discovery": "tsx --env-file-if-exists=.env scripts/export-discovery-snapshot.ts",
    "snapshot:responses": "tsx --env-file-if-exists=.env scripts/export-opportunity-snapshots.ts"
  },
  "dependencies": {
    "@algorandfoundation/algokit-utils": "^9.2.0",
    "@alpha-arcade/sdk": "^0.4.11",
    "@compx/sdk": "^2.1.5",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@folks-finance/algorand-sdk": "^0.2.6",
    "@myth-finance/dualstake-farm-sdk": "^3.2.7",
    "@myth-finance/dualstake-ts-sdk": "^0.3.7",
    "@pactfi/pactsdk": "^0.8.1",
    "@sinclair/typebox": "^0.34.49",
    "@tinymanorg/tinyman-js-sdk": "^5.1.4",
    "@txnlab/haystack-router": "^2.0.5",
    "algosdk": "^3.6.0",
    "fastify": "^5.8.5",
    "ioredis": "^5.11.1",
    "node-cron": "^4.6.0",
    "prom-client": "^15.1.3",
    "ulujs": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
