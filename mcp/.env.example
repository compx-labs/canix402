# Caddy gateway base URL (never point at raw Fastify upstream)
CANIX402_API_URL=https://canix402-api.compx.io

# Optional: payer wallet mnemonic for automatic x402 payments.
# Wallet needs ALGO for fees and must be opted into USDC (ASA 31566704 on mainnet).
# Never commit a real mnemonic.
CANIX402_WALLET_MNEMONIC=

# Algod endpoint used to fetch suggested params when signing payments
CANIX402_ALGOD_URL=https://mainnet-api.algonode.cloud

# Must match the gateway / facilitator network identifier
CANIX402_NETWORK=algorand-mainnet
