{
  "name": "canix402",
  "version": "0.1.0",
  "private": true,
  "description": "x402-gated Algorand DeFi opportunities data API",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "cli:opportunities": "tsx src/cli/opportunities.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test tests/integration/*.test.ts",
    "test:live": "tsx --test tests/live/*.test.ts",
    "test:x402-live": "tsx --test tests/live/x402-live.test.ts",
    "test:tinyman-live": "npm run test:live",
    "build:caddy-x402": "mkdir -p .bin && xcaddy build --output .bin/caddy-x402 --with github.com/algorandecosystem/caddy-x402avm=./caddy/plugin",
    "dev:caddy": ".bin/caddy-x402 run --config caddy/Caddyfile --adapter caddyfile",
    "test:x402-e2e": "tsx --test tests/e2e/*.test.ts",
    "test:ci": "npm run test && npm run test:x402-e2e"
  },
  "dependencies": {
    "@fastify/type-provider-typebox": "^6.1.0",
    "@folks-finance/algorand-sdk": "^0.2.6",
    "@sinclair/typebox": "^0.34.49",
    "@tinymanorg/tinyman-js-sdk": "^5.1.4",
    "algosdk": "^3.6.0",
    "fastify": "^5.8.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
