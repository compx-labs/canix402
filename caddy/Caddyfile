{
	order x402 before reverse_proxy
}

:{$CADDY_LISTEN_PORT} {
	@free path /health /metadata /discovery /openapi.json
	handle @free {
		reverse_proxy {$UPSTREAM_API}
	}

	@paid path /opportunities /protocols/*/opportunities
	handle @paid {
		x402 {
			description "canix402 paid DeFi data endpoint"
			mime_type application/json
			facilitator_url {$FACILITATOR_URL}

			accept {
				pay_to {$X402_PAY_TO}
				price {$X402_PRICE_USDC}
				network {$X402_NETWORK}
				scheme {$X402_SCHEME}
			}
		}

		reverse_proxy {$UPSTREAM_API}
	}

	handle {
		respond "not found" 404
	}
}
